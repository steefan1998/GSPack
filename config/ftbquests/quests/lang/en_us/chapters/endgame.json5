{
  "chapter.43AF5A6C91030254.chapter_subtitle": [
    "Master every pillar of the pack and craft creative items."
  ],
  "chapter.43AF5A6C91030254.title": "Endgame: Infinity",
  "quest.00547ACAB11645CC.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Omega and tier 7 stack upgrades for your backpack. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.00547ACAB11645CC.title": "Backpack Infinity Upgrade",
  "quest.048131CEA4B264AB.quest_desc": [
    "The Trophy of Infinity is crafted in a 9x9 &eUltimate Crafting Table&r.",
    "",
    "In GSPack it needs a &5Compressed Vibranium Block&r (All The Compressed) and an &eUltimate Control Circuit&r (Mekanism), on top of the Ultimate Components and Catalyst."
  ],
  "quest.048131CEA4B264AB.title": "Ultimate Crafting Table",
  "quest.0F9246D4F65EF111.quest_desc": [
    "Craft in an Elite Crafting Table (7x7) using Stellaris lunar resources, both boss trophies, Autopilot and Shield Modules, Space Station Blueprint, Nitro Energy Cell, Martian Navigation Core and Astrum Vitreus. Follow Cores: Cosmic Core and JEI."
  ],
  "quest.0F9246D4F65EF111.title": "Cosmic Core",
  "quest.1F4E2B13182CA4D7.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Ultimate upgrades and Antimatter. Pipes without limits. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.1F4E2B13182CA4D7.title": "Infinity Pipe Upgrade",
  "quest.2310F5804578FDB6.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Emerald and Netherite drawer upgrades. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.2310F5804578FDB6.title": "Creative Drawer Upgrade",
  "quest.24D85F4E0B73E8CE.quest_desc": [
    "Craft in an Elite Crafting Table (7x7) using The Bumblezone, The Aether II and Twilight Forest. Obtain Essence of the Bees, Royal Jelly, Glistering Honey Crystal, Gravitite, Zanite, Valkyrie Wings and Hydra, Ur-Ghast and Snow Queen trophies. Follow Cores: Dimensional Core and JEI."
  ],
  "quest.24D85F4E0B73E8CE.title": "Dimensional Core",
  "quest.2898DC9B19EB906F.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Fluid Tanks and Antimatter. An endless supply of any fluid. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.2898DC9B19EB906F.title": "Creative Fluid Tank",
  "quest.344B82BBFAAFB27B.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. A drawer that hands out endless copies of an item. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.344B82BBFAAFB27B.title": "Creative Vending Upgrade",
  "quest.36FD140C450E50BC.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Omega and tier 8 stack upgrades. A storage block with infinite room. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.36FD140C450E50BC.title": "Infinity Upgrade",
  "quest.392DEFF55226D216.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Portable Tanks and Super AI Chips. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.392DEFF55226D216.title": "Creative Oritech Tank",
  "quest.3C8AA2E3BE5359B4.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. 256k cells and Quantum Storage. An endless supply of any item in your ME network. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.3C8AA2E3BE5359B4.title": "Creative Storage Cell",
  "quest.4593CB8C7998DC0F.quest_desc": [
    "Craft in an Elite Crafting Table (7x7) with 25 farming and tree ingredients, including Productive Trees, Productive Farming, Mystical Agriculture and Aquaculture. Productive Bees remains optional. Follow Cores: Verdant Core and JEI."
  ],
  "quest.4593CB8C7998DC0F.title": "Verdant Core",
  "quest.45A5E6B642F0DE42.quest_desc": [
    "Use a Powah Energizing Orb with all five cores. The recipe consumes only these five ingredients and 1,000,000,000 FE. Powered Energizing Rods around the Orb supply energy; they are not recipe ingredients and are not consumed. See JEI."
  ],
  "quest.45A5E6B642F0DE42.title": "Creative Singularity",
  "quest.58B5171E08EAA508.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Large Storage blocks and Overcharged Crystals. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.58B5171E08EAA508.title": "Creative Oritech Storage",
  "quest.63A5F5C024728020.quest_desc": [
    "This is the end goal of &6GSPack&r.",
    "",
    "To reach it you need five &ecores&r, one for each pillar of the pack. Each core is made from the hardest items of its pillar, and its recipe draws on the capstones of those mods. This chapter can be started independently.",
    "",
    "Combine the five cores in a &dPowah Energizing Orb&r to create a &dCreative Singularity&r. Every &ecreative item&r needs one.",
    "",
    "Craft eight creative items and you can make the &6Trophy of Infinity&r.",
    "",
    "Creative items are made in an &eElite Crafting Table&r and the trophy in an &eUltimate Crafting Table&r (Extended Crafting).",
    "{@pagebreak}",
    "&eThe five cores&r",
    "- &bTechnological Core&r: Mekanism, Oritech, Applied Energistics 2",
    "- &5Arcane Core&r: Thaumaturge, Apotheosis, Equivox, Occultism",
    "- &aVerdant Core&r: Mystical Agriculture, Productive Trees, Productive Farming, Aquaculture",
    "- &6Dimensional Core&r: The Bumblezone, The Twilight Forest, The Aether II",
    "- &9Cosmic Core&r: Stellaris",
    "",
    "All recipes can be found in JEI. Good luck!"
  ],
  "quest.63A5F5C024728020.quest_subtitle": "Craft the Trophy of Infinity",
  "quest.63A5F5C024728020.title": "The Final Goal",
  "quest.64B2FEC45C848AF6.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Energy Cubes and Antimatter around a singularity. Endless power. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.64B2FEC45C848AF6.title": "Creative Energy Cube",
  "quest.68B2FC3C9BC435B4.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Nitro Energy Cells and Nitro Crystals. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.68B2FC3C9BC435B4.title": "Creative Energy Cell (Powah)",
  "quest.68F78D2D8BEAB826.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Chemical Tanks and Antimatter. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.68F78D2D8BEAB826.title": "Creative Chemical Tank",
  "quest.6DCDEED94D410642.quest_desc": [
    "Creative items are too big for a normal crafting table: they are crafted in a 7x7 &eElite Crafting Table&r from &bExtended Crafting&r.",
    "",
    "Work your way up: &eBasic&r (3x3), &eAdvanced&r (5x5) and &eElite&r (7x7). In GSPack each table needs materials from other mods:",
    "- Basic: a steel block and a Basic Control Circuit",
    "- Advanced: an Imperium Block and an Advanced Control Circuit",
    "- Elite: a Compressed Obsidian block and an Elite Control Circuit",
    "",
    "The creative item recipes also use &eBlack Iron Ingots&r, &eElite Components&r and &eCrystaltine Ingots&r. Check JEI!"
  ],
  "quest.6DCDEED94D410642.title": "Elite Crafting Table",
  "quest.6EF5BBD9118F05B1.quest_desc": [
    "Build the FE multiblock described in Cores: Technological Core. A central Crafting Core and 24 Pedestals combine Mekanism, Oritech, Advanced AE, AE2 and Powah components. The recipe consumes 250,000,000 FE at up to 25,000 FE/t. Check JEI and the dedicated Cores route."
  ],
  "quest.6EF5BBD9118F05B1.title": "Technological Core",
  "quest.71253CF4BB974D87.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Bins and Antimatter. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.71253CF4BB974D87.title": "Creative Bin",
  "quest.722C04D403F58970.quest_desc": [
    "&6You did it!&r",
    "",
    "The Trophy of Infinity is proof that you have mastered every corner of GSPack: technology, magic, farming, exploration and space.",
    "{@pagebreak}",
    "&7Recipe (Ultimate Crafting Table, 9x9), from the outside in:&r",
    "- The eight &2Twilight Forest&r boss trophies, 4 Nether Star Blocks, 4 Crystaltine Blocks, 8 &eDouble Compressed Netherite Blocks&r and 4 &eDouble Compressed Unobtainium-Vibranium Alloy Blocks&r.",
    "- The top item of 20 mods: MekaSuit Bodyarmor, Quantum Core, Black Hole, Infinite Energy Cell Array, Electric Locomotive, Nitro Energy Cell, Queen's Slime Ingot, Primordial Pearl, Godforged Pearl, Klein Star Omega, Insanium Gemstone Block, Dark Power Gem Block, Crystal Staff, Valkyrie Wings, Unobtainium-Vibranium Block, Heart of Luna and Star Crawler trophies, Neptunium Block, Novite Block and Gravitite Block. Plus 4 Creative Singularities and 4 Crystaltine Blocks.",
    "- The eight creative items: Creative Energy Cube, Creative Storage Cell, Creative Oritech Storage, Creative Powah Cell, Creative Essence, Infinity Upgrade, Creative Fluid Tank and Creative Energy Cell. Plus 4 Infinite Control Circuits and 4 &eCompressed Antimatter Blocks&r.",
    "- 4 more Creative Singularities and 4 Ultimate Components.",
    "- In the very middle: the &dUltimate Singularity&r.",
    "",
    "That is &d16 Creative Singularities&r in total, counting the ones in the creative items.",
    "",
    "Place it somewhere everyone can see it. Thank you for playing GSPack!"
  ],
  "quest.722C04D403F58970.title": "Trophy of Infinity",
  "quest.7B22113098F5905B.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Insanium and Awakened Supremium blocks. Grows any crop instantly. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.7B22113098F5905B.title": "Creative Essence",
  "quest.7B383D694996D3C1.quest_desc": [
    "Craft in an Elite Crafting Table (7x7). Required magic mods: Thaumaturge, Occultism, Equivox, Apotheosis, EvilCraft and Roots Classic. The recipe includes a Primordial Pearl, tier-4 Storage Stabilizer, Godforged Pearl, Red Matter, Klein Star Omega, Dark Power Gem Block and Crystal Staff. See Cores: Arcane Core for the full route and JEI for quantities."
  ],
  "quest.7B383D694996D3C1.title": "Arcane Core",
  "quest.7B993D9D41977366.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Dense Energy Cells and Quantum Processors. Your ME network never runs out of power. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r"
  ],
  "quest.7B993D9D41977366.title": "Creative Energy Cell",
  "quest.7BE71D092F5E8CBB.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Max Storage and Netherite upgrades. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.7BE71D092F5E8CBB.title": "Creative Vending (Functional Storage)",
  "quest.7D69FC9AA4346E41.quest_desc": [
    "The heart of the Trophy of Infinity: the &dUltimate Singularity&r from Extended Crafting.",
    "",
    "In GSPack it has its own recipe in the 9x9 &eUltimate Crafting Table&r:",
    "- All &e19 singularities&r. Each one is compressed from 10,000 of one material in the &eCompressor&r: iron, gold, copper, tin, steel, diamond and more.",
    "- A &dCreative Singularity&r in the middle.",
    "- 4 each of Antimatter Pellets, Insanium Gemstone Blocks, Compressed Unobtainium Blocks and Void Metal.",
    "- 8 &eTriple Compressed Iron Blocks&r (All The Compressed), 16 Black Iron Blocks, 5 Nether Star Blocks, 4 Crystaltine Blocks, 4 Ultimate Components, 4 Ultimate Catalysts and 4 Infinite Control Circuits.",
    "",
    "Start your compressors early and automate the materials! Check JEI for the full recipe."
  ],
  "quest.7D69FC9AA4346E41.title": "Ultimate Singularity",
  "quest.7DEB289538B47795.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Stack and Speed upgrades. Makes a Mekanism machine absurdly fast. Plus 4 double compressed blocks (All The Compressed), 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r"
  ],
  "quest.7DEB289538B47795.title": "Creative Upgrade"
}
