{
  "chapter.43AF5A6C91030254.chapter_subtitle": [
    "Master every pillar of the pack and craft creative items.",
  ],
  "chapter.43AF5A6C91030254.title": "Endgame: Infinity",
  "quest.00547ACAB11645CC.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Omega and tier 7 stack upgrades for your backpack. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.00547ACAB11645CC.title": "Backpack Infinity Upgrade",
  "quest.048131CEA4B264AB.quest_desc": [
    "The Trophy of Infinity is crafted in a 9x9 &eUltimate Crafting Table&r.",
    "",
    "In GSPack it needs a &5Vibranium Block&r (Allthemodium) and an &eUltimate Control Circuit&r (Mekanism), on top of the Ultimate Components and Catalyst.",
  ],
  "quest.048131CEA4B264AB.title": "Ultimate Crafting Table",
  "quest.0F9246D4F65EF111.quest_desc": [
    "Forged from the bosses of the Moon.",
    "",
    "&7Recipe:&r 4 Novite blocks, 2 Heart of Luna trophies, 2 Star Crawler trophies and a Nether Star in the middle.",
    "",
    "Unlocks after: the Heart of Luna, the Star Crawler Queen and Novite (Stellaris).",
  ],
  "quest.0F9246D4F65EF111.title": "Cosmic Core",
  "quest.1F4E2B13182CA4D7.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Ultimate upgrades and Antimatter. Pipes without limits. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.1F4E2B13182CA4D7.title": "Infinity Pipe Upgrade",
  "quest.2310F5804578FDB6.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Emerald and Netherite drawer upgrades. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.2310F5804578FDB6.title": "Creative Drawer Upgrade",
  "quest.24D85F4E0B73E8CE.quest_desc": [
    "Trophies and metals from the far-away worlds.",
    "",
    "&7Recipe:&r 4 Unobtainium-Vibranium blocks, a Snow Queen trophy, an Ur-Ghast trophy, 2 Gravitite blocks and a Piglich Heart block in the middle.",
    "",
    "Unlocks after: Unobtainium and the Piglich (Allthemodium), the Ur-Ghast and the Snow Queen (Twilight Forest) and Gravitite (Aether II).",
  ],
  "quest.24D85F4E0B73E8CE.title": "Dimensional Core",
  "quest.2898DC9B19EB906F.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Fluid Tanks and Antimatter. An endless supply of any fluid. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.2898DC9B19EB906F.title": "Creative Fluid Tank",
  "quest.344B82BBFAAFB27B.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. A drawer that hands out endless copies of an item. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.344B82BBFAAFB27B.title": "Creative Vending Upgrade",
  "quest.36FD140C450E50BC.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Omega and tier 8 stack upgrades. A storage block with infinite room. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.36FD140C450E50BC.title": "Infinity Upgrade",
  "quest.392DEFF55226D216.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Portable Tanks and Super AI Chips. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.392DEFF55226D216.title": "Creative Oritech Tank",
  "quest.3C8AA2E3BE5359B4.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. 256k cells and Quantum Storage. An endless supply of any item in your ME network. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.3C8AA2E3BE5359B4.title": "Creative Storage Cell",
  "quest.4593CB8C7998DC0F.quest_desc": [
    "The essence of everything that grows, and everything that swims.",
    "",
    "&7Recipe:&r 4 Insanium Gemstone blocks, 2 Nether Star Seeds, 2 Neptunium blocks and an Unobtainium Seed in the middle.",
    "",
    "Unlocks after: Insanium, the Nether Star and Unobtainium seeds (Seed Codex) and Neptunium (Aquaculture).",
  ],
  "quest.4593CB8C7998DC0F.title": "Verdant Core",
  "quest.45A5E6B642F0DE42.quest_desc": [
    "All five cores, collapsed into a single point.",
    "",
    "&7Recipe:&r the five cores and 4 Nether Stars.",
    "",
    "Every creative item needs one Creative Singularity, so you will need several. Automate your pillars!",
  ],
  "quest.45A5E6B642F0DE42.title": "Creative Singularity",
  "quest.58B5171E08EAA508.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Large Storage blocks and Overcharged Crystals. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.58B5171E08EAA508.title": "Creative Oritech Storage",
  "quest.63A5F5C024728020.quest_desc": [
    "This is the end goal of &6GSPack&r.",
    "",
    "To reach it you need five &ecores&r, one for each pillar of the pack. Each core is made from the hardest items of its pillar, and its quest only unlocks once you have finished the final quests of those chapters.",
    "",
    "Combine the five cores into a &dCreative Singularity&r. Every &ecreative item&r needs one.",
    "",
    "Craft eight creative items and you can make the &6Trophy of Infinity&r.",
    "",
    "Creative items are made in an &eElite Crafting Table&r and the trophy in an &eUltimate Crafting Table&r (Extended Crafting).",
    "{@pagebreak}",
    "&eThe five cores&r",
    "- &bTechnological Core&r: Mekanism, Oritech, Applied Energistics 2",
    "- &5Arcane Core&r: Thaumaturge, Apotheosis, Equivox, Mystical Agriculture",
    "- &aVerdant Core&r: Mystical Agriculture, Aquaculture, the Seed Codex",
    "- &6Dimensional Core&r: Allthemodium, The Twilight Forest, The Aether II",
    "- &9Cosmic Core&r: Stellaris",
    "",
    "All recipes can be found in JEI. Good luck!",
  ],
  "quest.63A5F5C024728020.quest_subtitle": "Craft the Trophy of Infinity",
  "quest.63A5F5C024728020.title": "The Final Goal",
  "quest.64B2FEC45C848AF6.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Energy Cubes and Antimatter around a singularity. Endless power. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.64B2FEC45C848AF6.title": "Creative Energy Cube",
  "quest.68B2FC3C9BC435B4.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Nitro Energy Cells and Nitro Crystals. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.68B2FC3C9BC435B4.title": "Creative Energy Cell (Powah)",
  "quest.68F78D2D8BEAB826.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Chemical Tanks and Antimatter. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.68F78D2D8BEAB826.title": "Creative Chemical Tank",
  "quest.6DCDEED94D410642.quest_desc": [
    "Creative items are too big for a normal crafting table: they are crafted in a 7x7 &eElite Crafting Table&r from &bExtended Crafting&r.",
    "",
    "Work your way up: &eBasic&r (3x3), &eAdvanced&r (5x5) and &eElite&r (7x7). In GSPack each table needs materials from other mods:",
    "- Basic: a steel block and a Basic Control Circuit",
    "- Advanced: an Imperium Block and an Advanced Control Circuit",
    "- Elite: a Refined Obsidian Block and an Elite Control Circuit",
    "",
    "The creative item recipes also use &eBlack Iron Ingots&r, &eElite Components&r and &eCrystaltine Ingots&r. Check JEI!",
  ],
  "quest.6DCDEED94D410642.title": "Elite Crafting Table",
  "quest.6EF5BBD9118F05B1.quest_desc": [
    "Antimatter, AI and quantum computing in one core.",
    "",
    "&7Recipe:&r 4 Antimatter Pellets, 2 Super AI Chips, 2 Quantum Processors and an Infinite Control Circuit in the middle.",
    "",
    "Unlocks after: the Infinite tier and the SPS (Mekanism), Advanced Computing (Oritech) and Advanced AE.",
  ],
  "quest.6EF5BBD9118F05B1.title": "Technological Core",
  "quest.71253CF4BB974D87.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Infinite Bins and Antimatter. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.71253CF4BB974D87.title": "Creative Bin",
  "quest.722C04D403F58970.quest_desc": [
    "&6You did it!&r",
    "",
    "The Trophy of Infinity is proof that you have mastered every corner of GSPack: technology, magic, farming, exploration and space.",
    "{@pagebreak}",
    "&7Recipe (Ultimate Crafting Table, 9x9), from the outside in:&r",
    "- The eight &2Twilight Forest&r boss trophies, 20 Crystaltine Blocks and 4 Nether Star Blocks.",
    "- The top item of 20 mods: MekaSuit Bodyarmor, Quantum Core, Black Hole, Infinite Energy Cell Array, Electric Locomotive, Nitro Energy Cell, Queen's Slime Ingot, Primordial Pearl, Godforged Pearl, Klein Star Omega, Insanium Gemstone Block, Dark Power Gem Block, Crystal Staff, Valkyrie Wings, Unobtainium-Vibranium Block, Heart of Luna and Star Crawler trophies, Neptunium Block, Novite Block and Gravitite Block. Plus 4 Creative Singularities.",
    "- The eight creative items: Creative Energy Cube, Creative Storage Cell, Creative Oritech Storage, Creative Powah Cell, Creative Essence, Infinity Upgrade, Creative Fluid Tank and Creative Energy Cell. Plus 4 Infinite Control Circuits and 4 Crystaltine Blocks.",
    "- 4 more Creative Singularities and 4 Ultimate Components.",
    "- In the very middle: the &dUltimate Singularity&r.",
    "",
    "That is &d16 Creative Singularities&r in total, counting the ones in the creative items.",
    "",
    "Place it somewhere everyone can see it. Thank you for playing GSPack!",
  ],
  "quest.722C04D403F58970.title": "Trophy of Infinity",
  "quest.7B22113098F5905B.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Insanium and Awakened Supremium blocks. Grows any crop instantly. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.7B22113098F5905B.title": "Creative Essence",
  "quest.7B383D694996D3C1.quest_desc": [
    "The combined power of every kind of magic in the pack.",
    "",
    "&7Recipe:&r 4 Void Metal blocks, 2 Godforged Pearls, 2 Red Matter blocks and a Primordial Pearl in the middle.",
    "",
    "Unlocks after: the Primordial Pearl (Thaumaturge), Godforged (Apotheosis), Red Matter (Equivox) and Awakened Supremium (Mystical Agriculture).",
  ],
  "quest.7B383D694996D3C1.title": "Arcane Core",
  "quest.7B993D9D41977366.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Dense Energy Cells and Quantum Processors. Your ME network never runs out of power. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&6Needed for the Trophy of Infinity.&r",
  ],
  "quest.7B993D9D41977366.title": "Creative Energy Cell",
  "quest.7BE71D092F5E8CBB.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Max Storage and Netherite upgrades. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.7BE71D092F5E8CBB.title": "Creative Vending (Functional Storage)",
  "quest.7D69FC9AA4346E41.quest_desc": [
    "The heart of the Trophy of Infinity: the &dUltimate Singularity&r from Extended Crafting.",
    "",
    "In GSPack it has its own recipe in the 9x9 &eUltimate Crafting Table&r:",
    "- All &e19 singularities&r. Each one is compressed from 10,000 of one material in the &eCompressor&r: iron, gold, copper, tin, steel, diamond and more.",
    "- A &dCreative Singularity&r in the middle.",
    "- 4 each of Antimatter Pellets, Insanium Gemstone Blocks, Unobtainium Blocks and Void Metal.",
    "- 24 Black Iron Blocks, 5 Nether Star Blocks, 4 Crystaltine Blocks, 4 Ultimate Components, 4 Ultimate Catalysts and 4 Infinite Control Circuits.",
    "",
    "Start your compressors early and automate the materials! Check JEI for the full recipe.",
  ],
  "quest.7D69FC9AA4346E41.title": "Ultimate Singularity",
  "quest.7DEB289538B47795.quest_desc": [
    "&7Recipe (Elite Crafting Table, 7x7):&r a Creative Singularity in the middle. Stack and Speed upgrades. Makes a Mekanism machine absurdly fast. Plus 16 Black Iron Ingots, 4 Elite Components and 4 Crystaltine Ingots.",
    "",
    "&7Optional: not needed for the trophy.&r",
  ],
  "quest.7DEB289538B47795.title": "Creative Upgrade",
}
