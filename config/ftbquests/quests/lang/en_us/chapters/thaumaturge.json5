{
  "chapter.4C8636F567767A4E.chapter_subtitle": [
    "Research the arcane: aspects, vis, essentia, infusion and the eldritch.",
  ],
  "chapter.4C8636F567767A4E.title": "Thaumaturge",
  "quest.00428375B942FF58.quest_desc": [
    "A huge construct of eldritch stone.",
  ],
  "quest.00428375B942FF58.title": "Eldritch Golem",
  "quest.008CBE652A6ACAD1.quest_desc": [
    "Staves are bigger than wands and hold even more vis.",
  ],
  "quest.008CBE652A6ACAD1.title": "Staff",
  "quest.01CBF8F6B23E4078.quest_desc": [
    "Ancient burial mounds hide loot urns and curios.",
  ],
  "quest.01CBF8F6B23E4078.title": "Barrow Mound",
  "quest.036877BA10A3D071.quest_desc": [
    "Automates crucible recipes using essentia from your jars.",
  ],
  "quest.036877BA10A3D071.title": "Thaumatorium",
  "quest.0583FCC9D1F3F43C.quest_desc": [
    "Swing around like a spider.",
  ],
  "quest.0583FCC9D1F3F43C.title": "Grapple Gun",
  "quest.0CED152555B15185.quest_desc": [
    "Thaumium tools infused with the power of the elements, each with a special ability.",
  ],
  "quest.0CED152555B15185.title": "Elemental Tools",
  "quest.0F871AE6433F594B.quest_desc": [
    "Automatically breaks items down into essentia. Bellows make it faster. Watch out for flux!",
  ],
  "quest.0F871AE6433F594B.title": "Essentia Smeltery",
  "quest.14109C8CEE42CD16.quest_desc": [
    "A dangerous device that tears holes in reality.",
  ],
  "quest.14109C8CEE42CD16.title": "Causality Collapser",
  "quest.16A2D295AACEB93C.quest_desc": [
    "Magical light that never goes out. Also a great heat source for the crucible.",
  ],
  "quest.16A2D295AACEB93C.title": "Nitor",
  "quest.1809C7659BF1FEC2.quest_desc": [
    "&eInfusion&r combines a central item, items on pedestals and essentia into powerful artifacts.",
    "",
    "Build the altar as shown in the Thaumonomicon, then activate the matrix with your wand.",
    "",
    "&cInstability&r: an uneven altar is unstable, which can cause bad things to happen. Keep it symmetrical and use stabilizers like candles and skulls.",
  ],
  "quest.1809C7659BF1FEC2.title": "Infusion Altar",
  "quest.18DEA94AE27D288E.quest_desc": [
    "Build golems from different materials, heads, arms and legs.",
  ],
  "quest.18DEA94AE27D288E.title": "Golem Press",
  "quest.192ADB61A87987E5.quest_desc": [
    "A wand channels vis. It is made from a &erod&r and two &ecaps&r. Better rods hold more vis, better caps reduce the vis cost.",
  ],
  "quest.192ADB61A87987E5.title": "Your First Wand",
  "quest.1B0D9B18770E1402.quest_desc": [
    "Solve research puzzles by linking aspects together on the research table. Each solved note unlocks new knowledge.",
  ],
  "quest.1B0D9B18770E1402.title": "Research Table",
  "quest.1CF31C8AFF1303F0.quest_desc": [
    "Strange obelisks of the Outer Gods. Something powerful is connected to them.",
  ],
  "quest.1CF31C8AFF1303F0.title": "Eldritch Obelisk",
  "quest.210BF8E7F9A3F6B3.quest_desc": [
    "Void robes combine strong protection with vis discounts.",
  ],
  "quest.210BF8E7F9A3F6B3.title": "Void Robes",
  "quest.246B75BB5BA40999.quest_desc": [
    "Magical jewellery. The Vis Amulet stores extra vis for your wand.",
  ],
  "quest.246B75BB5BA40999.title": "Rings, Amulets \\& Belts",
  "quest.25278CB1FFCC2D71.quest_desc": [
    "The &4Crimson Cult&r worships the Outer Gods. Their portals appear in the world and their knights and clerics are dangerous.",
    "",
    "Defeat their warriors.",
  ],
  "quest.25278CB1FFCC2D71.title": "The Crimson Cult",
  "quest.27CBE4668291D7BE.quest_desc": [
    "Wisps are floating balls of essentia that appear where magic is strong. They drop essentia crystals.",
  ],
  "quest.27CBE4668291D7BE.title": "Wisps",
  "quest.28F645FB532BEAA9.quest_desc": [
    "Cinnabar ore is found deep underground. Smelt it for quicksilver.",
  ],
  "quest.28F645FB532BEAA9.title": "Quicksilver",
  "quest.2A03590EF3738B08.quest_desc": [
    "The rarest magical item of all, and the key to the most powerful creations. You have mastered Thaumaturge!",
  ],
  "quest.2A03590EF3738B08.title": "Primordial Pearl",
  "quest.2ABD613AAF1ACC33.quest_desc": [
    "Scan blocks, items and creatures to learn their aspects. Scanning gives research points.",
  ],
  "quest.2ABD613AAF1ACC33.title": "Thaumometer",
  "quest.2DD7A8920B162391.quest_desc": [
    "Use Salis Mundus on a cauldron and fill it with water over a fire (or a nitor).",
    "",
    "Throw items in and they melt into &eessentia&r. Then throw in a catalyst to make an alchemy recipe from that essentia.",
  ],
  "quest.2DD7A8920B162391.title": "The Crucible",
  "quest.2E51FF3B7ECFCC73.quest_desc": [
    "A magical quarry turret.",
  ],
  "quest.2E51FF3B7ECFCC73.title": "Arcane Bore",
  "quest.310E7B7CAF1537ED.quest_desc": [
    "Rendered fat, used for candles and seals.",
  ],
  "quest.310E7B7CAF1537ED.title": "Tallow",
  "quest.31E92537BC10016D.quest_desc": [
    "Reduce infusion instability.",
  ],
  "quest.31E92537BC10016D.title": "Stabilizers",
  "quest.346196FB5B53ABC6.quest_desc": [
    "Run faster, jump higher and step up full blocks.",
  ],
  "quest.346196FB5B53ABC6.title": "Traveller's Boots",
  "quest.360A839064D31EBD.quest_desc": [
    "Curios found in dungeons and ruins give a lot of research knowledge when used.",
  ],
  "quest.360A839064D31EBD.title": "Curious Mind",
  "quest.372FF004746B204D.quest_desc": [
    "&bThaumaturge&r is a mod about magical research.",
    "",
    "Everything in the world is made of &easpects&r. The six &eprimal&r aspects are:",
    "&eAer&r (air), &bAqua&r (water), &cIgnis&r (fire), &2Terra&r (earth), &fOrdo&r (order) and &8Perditio&r (entropy).",
    "",
    "Find a crystal of each aspect growing in caves and break it for its &eVis Crystals&r.",
  ],
  "quest.372FF004746B204D.quest_subtitle": "The six primal aspects",
  "quest.372FF004746B204D.title": "Vis Crystals",
  "quest.38B4D8374D7FA2E9.quest_desc": [
    "Store essentia in warded jars. Labels lock a jar to one aspect.",
  ],
  "quest.38B4D8374D7FA2E9.title": "Warded Jars",
  "quest.3B3E5912CB6C33DD.quest_desc": [
    "Use Salis Mundus on a crafting table. Arcane recipes draw &evis&r from the aura of the chunk.",
  ],
  "quest.3B3E5912CB6C33DD.title": "Arcane Workbench",
  "quest.3BE6B04F477609A5.quest_desc": [
    "Combine crystals with redstone and flint to make &eSalis Mundus&r, the magical dust that turns ordinary blocks into magical ones.",
  ],
  "quest.3BE6B04F477609A5.title": "Salis Mundus",
  "quest.3F3BCFB2AA5BA1D7.quest_desc": [
    "Smarter golems can do more complex jobs.",
  ],
  "quest.3F3BCFB2AA5BA1D7.title": "Golem Minds",
  "quest.40D9143FA7C71B48.quest_desc": [
    "An eldritch metal that repairs itself. It makes the best tools and armor, but carries a warp...",
  ],
  "quest.40D9143FA7C71B48.title": "Void Metal",
  "quest.4150E0AE808C4FE1.quest_desc": [
    "See aspects, aura nodes and essentia contents without scanning.",
  ],
  "quest.4150E0AE808C4FE1.title": "Goggles of Revealing",
  "quest.4237B4C249386F8B.quest_desc": [
    "Cheat death.",
  ],
  "quest.4237B4C249386F8B.title": "Charm of Undying",
  "quest.432E451494D5C386.quest_desc": [
    "Use Salis Mundus on a bookshelf to make the &eThaumonomicon&r. All your research lives in this book.",
    "",
    "&6Tip:&r Read it! The book tells you exactly what to research next and how to build each device.",
  ],
  "quest.432E451494D5C386.title": "Thaumonomicon",
  "quest.436C2F2223AA5831.quest_desc": [
    "Design your own spells: choose the effect, the shape and the modifiers.",
  ],
  "quest.436C2F2223AA5831.title": "Focal Manipulator",
  "quest.450A0D646578A39A.quest_desc": [
    "Seals tell golems what to do: harvest crops, pick up items, fill chests, guard an area, chop trees and more.",
  ],
  "quest.450A0D646578A39A.title": "Seals",
  "quest.467A9D5F78FD9538.quest_desc": [
    "Amber ore is used for warded glass and essentia storage.",
  ],
  "quest.467A9D5F78FD9538.title": "Amber",
  "quest.47258A348571EA04.quest_desc": [
    "Better than iron and very enchantable.",
  ],
  "quest.47258A348571EA04.title": "Thaumium Tools",
  "quest.474C948258A6751B.quest_desc": [
    "Every chunk has an &eaura&r of vis. Arcane crafting uses it up, and it slowly recovers.",
    "",
    "&cFlux&r is the pollution of magic. Too much flux causes nasty side effects, and eventually &5taint&r. Keep your workshop clean!",
  ],
  "quest.474C948258A6751B.title": "The Aura",
  "quest.4C6E7186B8F45261.quest_desc": [
    "Make infusions faster or cheaper.",
  ],
  "quest.4C6E7186B8F45261.title": "Matrix Upgrades",
  "quest.4CAF4F9EC1BE2643.quest_desc": [
    "A silverwood rod holds much more vis.",
  ],
  "quest.4CAF4F9EC1BE2643.title": "Better Rods",
  "quest.4F695141DC70FFFF.quest_desc": [
    "Turn vis into power, and store vis for later.",
  ],
  "quest.4F695141DC70FFFF.title": "Vis Generation",
  "quest.5141611F8FB1934C.quest_desc": [
    "Powerful charms with permanent effects.",
  ],
  "quest.5141611F8FB1934C.title": "Charms",
  "quest.5312ECB1A112A6BF.quest_desc": [
    "Valves, filters and buffers let you build an essentia network.",
  ],
  "quest.5312ECB1A112A6BF.title": "Essentia Tubes",
  "quest.5781C4BF4619F4CA.quest_desc": [
    "Splits compound aspects into their parts.",
  ],
  "quest.5781C4BF4619F4CA.title": "Essentia Centrifuge",
  "quest.58D41B3149C99119.quest_desc": [
    "When flux runs out of control, &5taint&r spreads across the land, corrupting blocks and creatures.",
    "",
    "Clean it up before it consumes your base!",
  ],
  "quest.58D41B3149C99119.title": "Taint",
  "quest.5B0E64C3CB1AE523.quest_desc": [
    "A full set of thaumium armor.",
  ],
  "quest.5B0E64C3CB1AE523.title": "Thaumium Armor",
  "quest.5C5DFDBD839283A8.quest_desc": [
    "Enchanted fabric robes that reduce vis costs.",
  ],
  "quest.5C5DFDBD839283A8.title": "Thaumaturge's Robes",
  "quest.5CD67AFD5B090BE2.quest_desc": [
    "The strongest focus can hold the most complex spells.",
  ],
  "quest.5CD67AFD5B090BE2.title": "Master Focus",
  "quest.5E2AD0DD3DBCB7FB.quest_desc": [
    "Cleans flux from the air before it causes trouble.",
  ],
  "quest.5E2AD0DD3DBCB7FB.title": "Flux Scrubber",
  "quest.5E81F6C990874068.quest_desc": [
    "An explosive magical fuel.",
  ],
  "quest.5E81F6C990874068.title": "Alumentum",
  "quest.5FBA0BD048B358A5.quest_desc": [
    "Cultist gear is powerful, but wearing it whispers things into your mind.",
  ],
  "quest.5FBA0BD048B358A5.title": "Crimson Gear",
  "quest.5FF3AA24C03EBA95.quest_desc": [
    "Brass is used for tubes, mechanisms and many devices.",
  ],
  "quest.5FF3AA24C03EBA95.title": "Brass",
  "quest.6227906D77CCCA22.quest_desc": [
    "A focus holds a spell for your wand. Keep extra foci in the pouch.",
  ],
  "quest.6227906D77CCCA22.title": "Foci",
  "quest.652023BCDCF94D09.quest_desc": [
    "The silent guardians of the Outer Lands.",
  ],
  "quest.652023BCDCF94D09.title": "Eldritch Guardians",
  "quest.67F01A776843229F.quest_desc": [
    "Pechs are little creatures that trade magical goods... or you could take their stuff.",
  ],
  "quest.67F01A776843229F.title": "Pech Trader",
  "quest.6AC13432205033F0.quest_desc": [
    "Use the eldritch knowledge you gathered to enter the &5Outer Lands&r, a maze of ancient eldritch ruins.",
    "",
    "Guardians and golems protect the deepest secrets. Come with your best gear.",
  ],
  "quest.6AC13432205033F0.title": "The Outer Lands",
  "quest.6D72D11D5BB39654.quest_desc": [
    "Gold and thaumium caps make spells cheaper.",
  ],
  "quest.6D72D11D5BB39654.title": "Better Caps",
  "quest.702333BBA1942C30.quest_desc": [
    "Iron infused with magic. The base metal for most Thaumaturge gear.",
  ],
  "quest.702333BBA1942C30.title": "Thaumium",
  "quest.733CB50AFC97E258.quest_desc": [
    "Golems are your magical workers. Use the Golem Bell to pick them up and move them.",
  ],
  "quest.733CB50AFC97E258.title": "Golemancy",
  "quest.7349912078CB1C38.quest_desc": [
    "Self-repairing, powerful, and a little bit dangerous.",
  ],
  "quest.7349912078CB1C38.title": "Void Gear",
  "quest.7624F5519196194E.quest_desc": [
    "The warden of the eldritch labyrinth.",
  ],
  "quest.7624F5519196194E.title": "The Eldritch Warden",
  "quest.78C0207A63F05DA3.quest_desc": [
    "The Arcane Lamp lights up the area. The Lamp of Growth speeds up crops.",
  ],
  "quest.78C0207A63F05DA3.title": "Arcane Lamps",
  "quest.7A24E38BF021D429.quest_desc": [
    "Magical trees. Greatwood is common in forests, Silverwood is rare and full of order.",
  ],
  "quest.7A24E38BF021D429.title": "Greatwood \\& Silverwood",
  "quest.7A7032684AC8FFB8.quest_desc": [
    "Advanced seals have filters and more options.",
  ],
  "quest.7A7032684AC8FFB8.title": "Advanced Seals",
  "quest.7FB078AFCB499495.quest_desc": [
    "Collects essentia from a smelter below it.",
  ],
  "quest.7FB078AFCB499495.title": "Alembic",
  "task.0ECF91D895F1A675.title": "8 Brass Ingots (any mod)",
}
