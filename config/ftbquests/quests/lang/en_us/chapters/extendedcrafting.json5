  ],
  "quest.30800A279127E9EE.title": "Emerald Singularity",
  "quest.332E93979B2F1408.quest_desc": [
    "Extended Crafting adds larger crafting grids and machines for late-game production. GSPack changes many of its recipes. Use JEI for the installed recipes for machine recipes and uses. Read this introduction and tick the checkmark to begin. This chapter can be started independently.",
  ],
