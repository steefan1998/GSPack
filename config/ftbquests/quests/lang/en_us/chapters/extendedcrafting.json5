  "quest.47F9FA74B1CCFD3E.title": "Automatic Basic Table",
  "quest.48F7BBDC8926B0D8.quest_desc": [
    "The 7x7 table is used for GSPack creative items and other expensive recipes. It does not require completing another chapter to register this quest.",
