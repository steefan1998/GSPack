  "quest.33B7DFDBBB570022.title": "Silver Singularity",
  "quest.3EF87F711B496FFA.quest_desc": [
    "The first Extended Crafting table uses a 3x3 grid. GSPack adds cross-mod ingredients to table recipes; JEI is the authority for the materials.",
