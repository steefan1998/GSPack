{
  "chapter.674CEC491DA62D7F.chapter_subtitle": [
    "Bigger crafting grids, automation and the road to the Ultimate Singularity.",
  ],
  "chapter.674CEC491DA62D7F.title": "Extended Crafting",
  "quest.0064AF6558A64DC5.quest_desc": [
    "The 5x5 table handles many GSPack machines and several ingredients made craftable for the trophy. Check the recipe grid size in JEI.",
  ],
  "quest.0064AF6558A64DC5.title": "Advanced Table: 5x5",
  "quest.00C8F86867B203D3.quest_desc": [
    "Produce this specific singularity in the Quantum Compressor. Its component data identifies the material: another singularity type will not complete this quest. All 19 listed types are used in the GSPack Ultimate Singularity recipe.",
  ],
  "quest.00C8F86867B203D3.title": "Invar Singularity",
  "quest.08F3AB7C1F6C0108.quest_desc": [
    "Craft the GSPack 9x9 recipe with all 19 singularity types, a Creative Singularity and the other capstone materials shown in JEI. The optional material quests help track your collection.",
  ],
  "quest.08F3AB7C1F6C0108.title": "The Ultimate Singularity",
  "quest.0A3DDD9B7515597B.quest_desc": [
    "Automate supported 7x7 recipes. Plan ingredient supply before starting large jobs.",
  ],
  "quest.0A3DDD9B7515597B.title": "Automatic Elite Table",
  "quest.0B1E8B5FE8D9DD13.quest_desc": [
    "A building material for several Extended Crafting recipes. Check JEI for crafting and uses.",
  ],
