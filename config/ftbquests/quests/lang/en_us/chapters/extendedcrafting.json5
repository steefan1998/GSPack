  "quest.18AB3867111779A8.title": "Black Iron",
  "quest.1F0C79535E13AC87.quest_desc": [
    "A Crafting Core and nearby Pedestals handle combination crafting. Check JEI for supported recipes and their power requirements; this is a different system from table crafting.",
  ],
  "quest.1F0C79535E13AC87.title": "Combination Crafting",
