{
  "chapter.047B63A08B836A12.chapter_subtitle": [
    "Survive, gear up and conquer the Nether and the End."
  ],
  "chapter.047B63A08B836A12.title": "Getting Started",
  "quest.00C5B073D7228BF0.quest_desc": [
    "A full set of iron armor makes the night a lot less scary.",
    "",
    "Later you will find much better armor: Mekanism, Allthemodium, Twilight Forest, Aether II, Equivox..."
  ],
  "quest.00C5B073D7228BF0.title": "Suit Up",
  "quest.02F838BE73520B42.quest_desc": [
    "Wither skeletons sometimes drop their skull. You need three to summon the Wither."
  ],
  "quest.02F838BE73520B42.title": "Wither Skeleton Skulls",
  "quest.03311868BC2F0713.quest_desc": [
    "Trade with a villager. Librarians can sell enchanted books!"
  ],
  "quest.03311868BC2F0713.title": "Let's Make a Deal",
  "quest.053AC027954B3A77.quest_desc": [
    "Follow the Eyes of Ender to the stronghold. YUNG's Better Strongholds makes them a real dungeon!"
  ],
  "quest.053AC027954B3A77.title": "Stronghold",
  "quest.08A5707EE4F137B2.quest_desc": [
    "Find a village. Villagers trade emeralds for all kinds of goods.",
    "",
    "&6Tip:&r With &bEasy Villagers&r you can pick villagers up and put them in a block, and &bTrade Cycling&r lets you reroll their trades."
  ],
  "quest.08A5707EE4F137B2.title": "Neighbours",
  "quest.0B92F8869389DF65.quest_desc": [
    "Blazes spawn in fortresses. Blaze rods make brewing stands and Eyes of Ender."
  ],
  "quest.0B92F8869389DF65.title": "Blaze Rods",
  "quest.12497CCA826EA587.quest_desc": [
    "Stone tools are cheap and twice as durable as wooden ones.",
    "",
    "&6Tip:&r Hold the &eFTB Ultimine&r key while mining to break a whole vein of ore or a whole tree at once. It costs extra hunger, so bring food!"
  ],
  "quest.12497CCA826EA587.title": "Stone Age",
  "quest.13D9B637C3D524F9.quest_desc": [
    "Iron is the backbone of almost every mod in the pack. Find iron ore in caves and on mountains, and smelt it.",
    "",
    "&6Tip:&r The worldgen mods add huge caves. Bring torches and a bed, and mark the way back with waypoints."
  ],
  "quest.13D9B637C3D524F9.title": "Iron Age",
  "quest.1844A3F8D98F5859.quest_desc": [
    "Build a portal frame of obsidian (at least 4x5) and light it with &eFlint and Steel&r.",
    "",
    "The Nether is hot and dangerous. Bring fire resistance if you can, and never dig straight down!"
  ],
  "quest.1844A3F8D98F5859.title": "Into the Nether",
  "quest.1E802954F54DB30C.quest_desc": [
    "Portable storage that keeps its items when broken."
  ],
  "quest.1E802954F54DB30C.title": "Shulker Boxes",
  "quest.1ECCE1E4948233AF.quest_desc": [
    "No coal yet? Smelt a log into &echarcoal&r. Torches keep monsters from spawning around your base."
  ],
  "quest.1ECCE1E4948233AF.title": "Light in the Dark",
  "quest.228347B50D1DC622.quest_desc": [
    "Upgrade diamond gear to netherite in a smithing table. A netherite pickaxe is needed for Allthemodium!"
  ],
  "quest.228347B50D1DC622.title": "Netherite",
  "quest.276DC53B9244028E.quest_desc": [
    "Find a Nether Fortress. YUNG's Better Nether Fortresses makes them much bigger and more dangerous."
  ],
  "quest.276DC53B9244028E.title": "Nether Fortress",
  "quest.29E4F38DE93324E5.quest_desc": [
    "Carry water and lava. A water bucket can save you from a fatal fall!"
  ],
  "quest.29E4F38DE93324E5.title": "Buckets",
  "quest.2C62B4B7D60B9A98.quest_desc": [
    "Fight waves of monsters for trial keys and vault loot."
  ],
  "quest.2C62B4B7D60B9A98.title": "Trial Chambers",
  "quest.3970F27352844017.quest_desc": [
    "A farm gives you endless food. Till dirt with a hoe next to water and plant seeds.",
    "",
    "Later, &bMystical Agriculture&r lets you grow almost every resource in the same way!"
  ],
  "quest.3970F27352844017.title": "First Farm",
  "quest.39C5317DBE092F57.quest_desc": [
    "Kill creepers before they reach your walls. Gunpowder is needed for TNT, rockets and more."
  ],
  "quest.39C5317DBE092F57.title": "That's a Nice Base...",
  "quest.3AA2B42527349AA7.quest_desc": [
    "Upgrades can pick items up, pull them in, sort, compact, feed you and much more."
  ],
  "quest.3AA2B42527349AA7.title": "Backpack Upgrades",
  "quest.3E06872A556B9FF9.quest_desc": [
    "Nether wart grows in fortresses and is the base of almost every potion."
  ],
  "quest.3E06872A556B9FF9.title": "Potion Brewing",
  "quest.3EA54B1396E07FB1.quest_desc": [
    "Fill the portal frame with Eyes of Ender and jump in.",
    "",
    "&cThe Ender Dragon is waiting.&r Bring blocks, a good bow, food and water buckets."
  ],
  "quest.3EA54B1396E07FB1.title": "The End",
  "quest.3FB6B561A952EF9A.quest_desc": [
    "Bastions are full of piglins and great loot, including netherite upgrade templates."
  ],
  "quest.3FB6B561A952EF9A.title": "Bastion Remnant",
  "quest.4034820F97D1187D.quest_desc": [
    "Breed two animals of the same kind by feeding them. Cows, sheep, pigs and chickens all make great farms."
  ],
  "quest.4034820F97D1187D.title": "Animal Husbandry",
  "quest.40B5CC37297FEFE7.quest_desc": [
    "Build a simple shelter with a wooden door and some storage: chests or barrels of any wood, from any mod.",
    "",
    "&6Tip:&r Claim your base on the map (&eM&r) so other players cannot grief it. Later, upgrade your storage with &bSophisticated Storage&r."
  ],
  "quest.40B5CC37297FEFE7.title": "A Place to Call Home",
  "quest.419DB53725DF2086.quest_desc": [
    "Skeletons drop bones and arrows. Bone meal speeds up your crops."
  ],
  "quest.419DB53725DF2086.title": "Bone Collector",
  "quest.431F7DAB107E0094.quest_desc": [
    "End cities hold shulkers, great loot and sometimes an End Ship."
  ],
  "quest.431F7DAB107E0094.title": "End City",
  "quest.477FC211D71AD53C.quest_desc": [
    "Sleep through the night and set your spawn point.",
    "",
    "Wool comes from sheep. Any colour of bed works for the pack, but the quest asks for a &fwhite&r one. Dye it later if you like."
  ],
  "quest.477FC211D71AD53C.title": "Sweet Dreams",
  "quest.4B9EA97201096B46.quest_desc": [
    "Found deep in the Nether, near the lava ocean level. It does not burn in lava."
  ],
  "quest.4B9EA97201096B46.title": "Ancient Debris",
  "quest.4C4EC7B67B11507A.quest_desc": [
    "Smelt ores, cook food and make charcoal from logs. The &eIron Furnaces&r mod has much faster furnaces later on."
  ],
  "quest.4C4EC7B67B11507A.title": "Furnace",
  "quest.4E7A2D7D3D4E5E8F.quest_desc": [
    "Diamonds are found deep underground, most commonly around &eY -58&r.",
    "",
    "Use them for tools, the enchanting table, and countless machine recipes."
  ],
  "quest.4E7A2D7D3D4E5E8F.title": "Diamonds!",
  "quest.505D148A11E82581.quest_desc": [
    "&bWaystones&r appear in villages and in the wild. Activate one and you can teleport to it from any other waystone.",
    "",
    "The &eWarp Stone&r lets you open the waystone menu from anywhere. Return Scrolls take you back to your bed."
  ],
  "quest.505D148A11E82581.title": "Waystones",
  "quest.537EB39A51D60D0E.quest_desc": [
    "A diamond pickaxe is needed to mine obsidian."
  ],
  "quest.537EB39A51D60D0E.title": "Diamond Gear",
  "quest.53BE0D7FD7901D47.quest_desc": [
    "Build the Wither out of 4 soul sand and 3 wither skeleton skulls. Fight it underground or far from your base!",
    "",
    "The Nether Star is needed for beacons and many endgame recipes."
  ],
  "quest.53BE0D7FD7901D47.title": "The Wither",
  "quest.54D7863439518724.quest_desc": [
    "Magma cream makes fire resistance potions. Very useful in the Nether and for the Hydra in the Twilight Forest."
  ],
  "quest.54D7863439518724.title": "Fire Resistance",
  "quest.5508C69A421B6A4A.quest_desc": [
    "Mine nether gold ore or trade with piglins. Wear gold armor so piglins stay friendly."
  ],
  "quest.5508C69A421B6A4A.title": "Gold Rush",
  "quest.56F88E59D27D3217.quest_desc": [
    "Pour water onto still lava to make obsidian. You need at least 10 for a Nether portal."
  ],
  "quest.56F88E59D27D3217.title": "Obsidian",
  "quest.5800B83D1C324A8C.quest_desc": [
    "An iron pickaxe can mine diamonds, gold and redstone."
  ],
  "quest.5800B83D1C324A8C.title": "Iron Tools",
  "quest.58DDEFB26BE4BF64.quest_desc": [
    "Combine blaze powder with ender pearls. Throw an eye and follow it to the stronghold."
  ],
  "quest.58DDEFB26BE4BF64.title": "Eyes of Ender",
  "quest.58F5D899F875CFA6.quest_desc": [
    "Defeat 20 zombies. Apotheosis can give monsters affixes, so watch out for ones with coloured names!"
  ],
  "quest.58F5D899F875CFA6.title": "Night Watch",
  "quest.5B8F6F47EDD063B7.quest_desc": [
    "Deep below, in the Deep Dark, lie ancient cities with amazing loot.",
    "",
    "&cBe very quiet.&r Sneak everywhere and do not wake the Warden."
  ],
  "quest.5B8F6F47EDD063B7.title": "Ancient City",
  "quest.5C3EEB1D90C2418F.quest_desc": [
    "Destroy the End Crystals on the pillars first, then defeat the &5Ender Dragon&r.",
    "",
    "Afterwards, End gateways lead to the outer islands."
  ],
  "quest.5C3EEB1D90C2418F.title": "Free the End",
  "quest.67040F55FA5DC25C.quest_desc": [
    "The 3x3 crafting grid unlocks almost every recipe. Use JEI (press &eR&r on an item) when you do not know a recipe."
  ],
  "quest.67040F55FA5DC25C.title": "Crafting Table",
  "quest.6753BBD5CB523EC1.quest_desc": [
    "Place it on a pyramid of iron, gold, emerald, diamond or netherite blocks for powerful effects."
  ],
  "quest.6753BBD5CB523EC1.title": "Beacon",
  "quest.6C11BF4FECBD5F79.quest_desc": [
    "Used in AE2, Mekanism and many other mods."
  ],
  "quest.6C11BF4FECBD5F79.title": "Nether Quartz",
  "quest.6CAD900740E89982.quest_desc": [
    "Found on End Ships. Fly with fireworks!"
  ],
  "quest.6CAD900740E89982.title": "Wings",
  "quest.762001E5715650EC.quest_desc": [
    "A backpack gives you extra storage on the go. Upgrade it to iron, gold, diamond and netherite tiers."
  ],
  "quest.762001E5715650EC.title": "Pack Your Bags",
  "quest.7621BA229BBA5E6C.quest_desc": [
    "Combine and repair enchanted gear, and rename items."
  ],
  "quest.7621BA229BBA5E6C.title": "Anvil",
  "quest.76B23B29AD1A4DE3.quest_desc": [
    "Copper is used in many tech recipes, from Mekanism cables to Oritech machines."
  ],
  "quest.76B23B29AD1A4DE3.title": "Copper",
  "quest.76C68CDBBF53C3E2.quest_desc": [
    "The enchanting table is the start of the &bApotheosis&r chapter. It works very differently in this pack: bookshelves give &eEterna&r, &eQuanta&r and &eArcana&r stats.",
    "",
    "Check the Apotheosis chapter for the details."
  ],
  "quest.76C68CDBBF53C3E2.title": "Magic Words",
  "quest.78311BA5173B2B31.quest_desc": [
    "Block arrows, creeper explosions and melee hits by holding right-click."
  ],
  "quest.78311BA5173B2B31.title": "Shield",
  "quest.798BBF8CA6794607.quest_desc": [
    "The classic start. Collect &e1 log&r of any kind: oak, birch, spruce, the trees from Terralith, the Twilight Forest, the Aether... they all count. The quest completes as soon as you carry one log.",
    "",
    "Turn logs into planks, planks into sticks and a &eCrafting Table&r. From here you can make your first tools.",
    "",
    "&6Tip:&r Terralith and the other worldgen mods make the world much bigger and more varied than vanilla. Take a look around before you settle down!"
  ],
  "quest.798BBF8CA6794607.quest_subtitle": "Every journey starts with wood",
  "quest.798BBF8CA6794607.title": "Punch a Tree",
  "quest.7A42D8A8172E48EE.quest_desc": [
    "Netherite gear does not burn and keeps you safe in the Nether."
  ],
  "quest.7A42D8A8172E48EE.title": "Netherite Gear",
  "quest.7DEFC22484C31C0B.quest_desc": [
    "Cook some beef. Hunger matters a lot when you start using Ultimine and jetpacks.",
    "",
    "&6Tip:&r &bAppleSkin&r shows how much hunger and saturation each food restores."
  ],
  "quest.7DEFC22484C31C0B.title": "Something to Eat",
  "task.2AD05A4876E73EF8.title": "1 log of any kind",
  "task.0971802368A3E8FB.title": "2 Chests or Barrels",
  "task.137E3A327CCD7813.title": "A wooden door"
}
