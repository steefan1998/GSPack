{
  "chapter.2C19BB0712B6C63A.chapter_subtitle": [
    "Nature magic: herbs, powders, spells and rituals.",
  ],
  "chapter.2C19BB0712B6C63A.title": "Roots Classic",
  "quest.060E2612E2122034.quest_desc": [
    "Use the Bark Knife on logs to peel off &ebark&r. Every type of wood gives its own bark, and many recipes need it.",
  ],
  "quest.060E2612E2122034.title": "Bark Knife",
  "quest.13D8524B00A3D0F1.quest_desc": [
    "Living tools are made with a ritual and repair themselves.",
  ],
  "quest.13D8524B00A3D0F1.title": "Living Tools",
  "quest.20AFD499F96DC28D.quest_desc": [
    "Roots uses plants from all over the world. Press U on these herbs in JEI to see where they come from.",
  ],
  "quest.20AFD499F96DC28D.title": "Herb Gathering",
  "quest.22D6ADDBDC4C7075.quest_desc": [
    "Druid clothing, made with a ritual.",
  ],
  "quest.22D6ADDBDC4C7075.title": "Sylvan Robes",
  "quest.3CEC3DABA7041067.quest_desc": [
    "An advanced staff for the most powerful magic. See the Runic Tablet for how to make it.",
  ],
  "quest.3CEC3DABA7041067.title": "Crystal Staff",
  "quest.444C6EDFF52F9151.quest_desc": [
    "Use Spell Powder on the &eImbuer&r to create a &eStaff&r that casts that spell. Each staff has a number of uses.",
  ],
  "quest.444C6EDFF52F9151.title": "The Staff",
  "quest.48B5626F56522A07.quest_desc": [
    "&bRoots Classic&r is druid magic: you gather herbs and bark, grind them into powders, and use them for spells and rituals.",
    "",
    "The &eRunic Tablet&r is the guide to everything in the mod. Read it whenever you are stuck.",
  ],
  "quest.48B5626F56522A07.quest_subtitle": "The magic of nature",
  "quest.48B5626F56522A07.title": "Runic Tablet",
  "quest.4BF975DA337660A2.quest_desc": [
    "Wildwood armor, made with a ritual. See the Runic Tablet for what it needs.",
  ],
  "quest.4BF975DA337660A2.title": "Wildwood Armor",
  "quest.4F7E0F59656282CB.quest_desc": [
    "Berries make healthy food, like Fruit Salad and Rooty Stew.",
  ],
  "quest.4F7E0F59656282CB.title": "Wild Berries",
  "quest.570C9373E09DB641.quest_desc": [
    "Use it on dirt to grow grass.",
  ],
  "quest.570C9373E09DB641.title": "Growth Powder",
  "quest.589402B978D9F963.quest_desc": [
    "Standing stones around the altar power rituals.",
  ],
  "quest.589402B978D9F963.title": "Standing Stones",
  "quest.5D66F377F4D2A7E9.quest_desc": [
    "Grind herbs, bark and other ingredients into powders. JEI shows each recipe.",
  ],
  "quest.5D66F377F4D2A7E9.title": "Mortar \\& Pestle",
  "quest.61695EC9B8EEBDDD.quest_desc": [
    "Spell Powder holds a spell. Which spell depends on the ingredients you grind into it: see the Runic Tablet.",
  ],
  "quest.61695EC9B8EEBDDD.title": "Spell Powder",
  "quest.6D5A4299B6BB53DE.quest_desc": [
    "A herbal remedy: eat it for instant healing.",
  ],
  "quest.6D5A4299B6BB53DE.title": "Healing Poultice",
  "quest.6ED22DE8413C81A3.quest_desc": [
    "Rituals are performed at an &eAltar&r. The &eBrazier&r burns incense during the ritual. Each ritual needs its own ingredients and standing stones: see the Runic Tablet.",
  ],
  "quest.6ED22DE8413C81A3.title": "Altar \\& Brazier",
  "quest.7E182220D4EA2F94.quest_desc": [
    "Some standing stones have a lasting effect: the Grower Stone boosts plant growth and the Healer Stone gives regeneration nearby.",
  ],
  "quest.7E182220D4EA2F94.title": "Living Stones",
}
