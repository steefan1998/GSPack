  "quest.50FEB32102DA1B63.title": "Infinite Control Circuit",
  "quest.58F1821D4D677B88.quest_desc": [
    "Build a 7x7 outer ring of 24 Pedestals around a Crafting Core at the SAME height. Put an Advanced AE Quantum Core on the central core. Use ONE ingredient per pedestal: eight different technology items, eight Elite Components, four double-compressed Osmium Blocks and four Black Iron Blocks. Supply 250,000,000 FE, up to 25,000 FE/t. At full power and 20 TPS the craft takes 8 minutes 20 seconds. Check JEI. Do not add unrelated ingredients.",
  ],
  "quest.58F1821D4D677B88.title": "FE Assembly Multiblock",
  "quest.60DBC76598BAD3F8.quest_desc": [
