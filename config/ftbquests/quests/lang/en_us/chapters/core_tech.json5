  ],
  "quest.60DBC76598BAD3F8.title": "Singularity",
  "quest.658513EC7CA603CC.quest_desc": [
    "Complete this route independently. Quests do not consume ingredients. JEI shows exact quantities. Combine all five cores in a Powah Energizing Orb with 1 billion FE.",
  ],
  "quest.658513EC7CA603CC.title": "Technological Core: Start",
  "quest.673E8E7E473906CB.quest_desc": [
