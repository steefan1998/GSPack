{
  "chapter.6E76DF027A8636CC.chapter_subtitle": [
    "Eternal twilight: strange creatures, treasures and mighty bosses.",
  ],
  "chapter.6E76DF027A8636CC.title": "The Twilight Forest",
  "quest.003BD5C8BA26D06F.quest_desc": [
    "Strong armor made from Naga Scales.",
  ],
  "quest.003BD5C8BA26D06F.title": "Naga Armor",
  "quest.005D1ADAD7D6C496.quest_desc": [
    "A huge tower of towerwood in the Dark Forest, full of carminite ghasts and traps.",
  ],
  "quest.005D1ADAD7D6C496.title": "Dark Tower",
  "quest.01E8E1AC73478914.quest_desc": [
    "Shows ores underground.",
  ],
  "quest.01E8E1AC73478914.title": "Ore Map",
  "quest.04C6E50A59958DE9.quest_desc": [
    "The biggest hollow hills have the best loot, and the most monsters.",
  ],
  "quest.04C6E50A59958DE9.title": "Large Hollow Hill",
  "quest.052B7B18C399981F.quest_desc": [
    "Blows enemies (and you) away, and lets you glide.",
  ],
  "quest.052B7B18C399981F.title": "Peacock Feather Fan",
  "quest.08C501337DB1C855.quest_desc": [
    "Deals extra damage when you charge with it.",
  ],
  "quest.08C501337DB1C855.title": "Minotaur Axe",
  "quest.0BF55BCC7DDEF0B1.quest_desc": [
    "In the snowy forest, an icy cave holds the Alpha Yeti.",
  ],
  "quest.0BF55BCC7DDEF0B1.title": "Yeti Cave",
  "quest.0C43CC5D0817F816.quest_desc": [
    "A huge underground stronghold full of goblin knights.",
  ],
  "quest.0C43CC5D0817F816.title": "Goblin Stronghold",
  "quest.0D4E0A019D06CB17.quest_desc": [
    "Dropped by the tower's creatures. Used for magical machines.",
  ],
  "quest.0D4E0A019D06CB17.title": "Carminite",
  "quest.0D57735AF34EAC78.quest_desc": [
    "A stone circle with a strange ram. Feed it wool of every colour...",
  ],
  "quest.0D57735AF34EAC78.title": "Quest Grove",
  "quest.0F367F1D13A78D66.quest_desc": [
    "Comes pre-enchanted!",
  ],
  "quest.0F367F1D13A78D66.title": "Ironwood Gear",
  "quest.10EE9C94A45FAD26.quest_desc": [
    "Freezes everything around where it lands.",
  ],
  "quest.10EE9C94A45FAD26.title": "Ice Bomb",
  "quest.1381962127457CCC.quest_desc": [
    "Dropped by leafy Twilight creatures and found in chests.",
  ],
  "quest.1381962127457CCC.title": "Steeleaf",
  "quest.142AD2FDCDD041DC.quest_desc": [
    "Feed the Questing Ram one wool of all 16 colours for a great reward.",
  ],
  "quest.142AD2FDCDD041DC.title": "The Questing Ram",
  "quest.151EF83F2A2F8BB5.quest_desc": [
    "The ruler of the Aurora Palace, surrounded by ice crystals.",
  ],
  "quest.151EF83F2A2F8BB5.title": "The Snow Queen",
  "quest.15D1738730C62B0B.quest_desc": [
    "Phantom armor stays with you when you die.",
  ],
  "quest.15D1738730C62B0B.title": "Phantom Armor",
  "quest.1845A817A24CA9C0.quest_desc": [
    "At the very top of the Highlands stands the &5Final Castle&r. It is the end of your journey through the Twilight Forest... for now.",
    "",
    "Congratulations, adventurer!",
  ],
  "quest.1845A817A24CA9C0.title": "The Final Castle",
  "quest.18F6AD6064E59757.quest_desc": [
    "A three-headed fire beast. Hit its heads when they open their mouths. Each head has its own health.",
  ],
  "quest.18F6AD6064E59757.title": "The Hydra",
  "quest.19AE144214D7EAE3.quest_desc": [
    "The Lich drops one of four magic scepters. Collect them all!",
  ],
  "quest.19AE144214D7EAE3.title": "Scepters",
  "quest.1AE0E235D6CE8F18.quest_desc": [
    "Redcaps, skeleton druids and twilight wolves roam the forest. Clear a few out.",
  ],
  "quest.1AE0E235D6CE8F18.title": "Forest Dangers",
  "quest.1B0A1C52A7B072A2.quest_desc": [
    "Hunt the forest's animals for food.",
  ],
  "quest.1B0A1C52A7B072A2.title": "Twilight Wildlife",
  "quest.1BC5B381AD5F73EA.quest_desc": [
    "Combine with iron for more fiery ingots.",
  ],
  "quest.1BC5B381AD5F73EA.title": "Fiery Tears",
  "quest.1BE571A11A913294.quest_desc": [
    "Some of the toughest gear in the Twilight Forest.",
  ],
  "quest.1BE571A11A913294.title": "Knightmetal Gear",
  "quest.1D7D00716D50E06B.quest_desc": [
    "Crumbles stone and wood around you.",
  ],
  "quest.1D7D00716D50E06B.title": "Crumble Horn",
  "quest.1D87CDAA7573D566.quest_desc": [
    "Made from minotaur meat. It raises your maximum health for a while.",
  ],
  "quest.1D87CDAA7573D566.title": "Meef Stroganoff",
  "quest.1E43C17883A91294.quest_desc": [
    "Knightmetal is made from armor shards. Knightmetal gear is very strong.",
  ],
  "quest.1E43C17883A91294.title": "Knightmetal",
  "quest.202C38FFDFB0835A.quest_desc": [
    "Turns some creatures into their Twilight versions.",
  ],
  "quest.202C38FFDFB0835A.title": "Transformation Powder",
  "quest.2508F319061163B6.quest_desc": [
    "The Twilight Forest's bows: triple-shot, homing, freezing and teleporting.",
  ],
  "quest.2508F319061163B6.title": "Bows of the Queen",
  "quest.25CEBACB29DAB926.quest_desc": [
    "The Twilight Forest has many unique woods: twilight oak, canopy, mangrove, darkwood and the magic trees.",
  ],
  "quest.25CEBACB29DAB926.title": "Canopy Trees",
  "quest.26C823BB2981294B.quest_desc": [
    "A huge meal from the Hydra.",
  ],
  "quest.26C823BB2981294B.title": "Hydra Chop",
  "quest.27F3C5C96CBFD07A.quest_desc": [
    "The giants drop enormous tools that give you more reach.",
  ],
  "quest.27F3C5C96CBFD07A.title": "Giant Tools",
  "quest.2A002C80774DAA95.quest_desc": [
    "A tall tower full of spawners. The Lich waits at the top.",
  ],
  "quest.2A002C80774DAA95.title": "Lich Tower",
  "quest.2A272D59D0D618E0.quest_desc": [
    "In the fire swamp, deep in a cave, lives the Hydra. Fire resistance is a must!",
  ],
  "quest.2A272D59D0D618E0.title": "Hydra Lair",
  "quest.2A637859679913CA.quest_desc": [
    "Hills hollowed out by monsters, full of ore, spawners and treasure chests.",
  ],
  "quest.2A637859679913CA.title": "Hollow Hills",
  "quest.2B9DDC66515D8E67.quest_desc": [
    "A Magic Map shows biomes and the major structures. Very useful for finding boss lairs.",
  ],
  "quest.2B9DDC66515D8E67.title": "Magic Map",
  "quest.2BAC5B831324A6E5.quest_desc": [
    "A pickaxe made for breaking mazestone.",
  ],
  "quest.2BAC5B831324A6E5.title": "Mazebreaker",
  "quest.2C1F55C4F0F214D4.quest_desc": [
    "A ruined stone courtyard, home of the Naga.",
  ],
  "quest.2C1F55C4F0F214D4.title": "Naga Courtyard",
  "quest.2EBC57887E5DAD49.quest_desc": [
    "A map that shows the labyrinth around you.",
  ],
  "quest.2EBC57887E5DAD49.title": "Maze Map",
  "quest.351722182C92C500.quest_desc": [
    "Freezes attackers.",
  ],
  "quest.351722182C92C500.title": "Yeti Armor",
  "quest.39C1F81A881EB99C.quest_desc": [
    "Six phantom knights guard the heart of the stronghold. Defeat them all!",
  ],
  "quest.39C1F81A881EB99C.title": "Knight Phantoms",
  "quest.3AFA2AC806552D6F.quest_desc": [
    "Destroys blocks and enemies in its path.",
  ],
  "quest.3AFA2AC806552D6F.title": "Cube of Annihilation",
  "quest.3CB6701BEE2F958A.quest_desc": [
    "Four rare magic trees have a powerful core:",
    "- &eTree of Time&r: speeds up things around it.",
    "- &eTree of Transformation&r: turns the biome into Enchanted Forest.",
    "- &eMinewood&r: mines ores nearby.",
    "- &eSortingwood&r: sorts items into chests.",
  ],
  "quest.3CB6701BEE2F958A.title": "Magic Trees",
  "quest.3CE285D8EF1440F1.quest_desc": [
    "A maze of thorny hedges with chests and spiders.",
  ],
  "quest.3CE285D8EF1440F1.title": "Hedge Maze",
  "quest.3D2737CFE28F1BE3.quest_desc": [
    "Fiery tools set things on fire and auto-smelt what they mine.",
  ],
  "quest.3D2737CFE28F1BE3.title": "Fiery Ingots",
  "quest.3D44E0ACEF36D1C3.quest_desc": [
    "The Lamp of Cinders burns away the thorns that block the way to the Final Castle.",
  ],
  "quest.3D44E0ACEF36D1C3.title": "Lamp of Cinders",
  "quest.3E4A0CF2B5D3AA4F.quest_desc": [
    "Found in the roots underground. Used to make Ironwood.",
  ],
  "quest.3E4A0CF2B5D3AA4F.title": "Liveroot",
  "quest.44640A65CA981E23.quest_desc": [
    "A huge hollow tree with a secret inside.",
  ],
  "quest.44640A65CA981E23.title": "Hollow Tree",
  "quest.457EBEFCF1C936A3.quest_desc": [
    "A shimmering palace on the glacier.",
  ],
  "quest.457EBEFCF1C936A3.title": "Aurora Palace",
  "quest.47144303D893D8EA.quest_desc": [
    "The Dark Tower's magical devices: a builder, a reactor and the ghast trap.",
  ],
  "quest.47144303D893D8EA.title": "Carminite Machines",
  "quest.4B044ED809AADD5D.quest_desc": [
    "Torchberry plants hang from cave ceilings. They glow!",
  ],
  "quest.4B044ED809AADD5D.title": "Torchberries",
  "quest.4B2E868AF488F13B.quest_desc": [
    "Pulls ore veins towards you.",
  ],
  "quest.4B2E868AF488F13B.title": "Ore Magnet",
  "quest.4DD350ED4DC51778.quest_desc": [
    "Dodge the falling ice and hit the Yeti when it is tired.",
  ],
  "quest.4DD350ED4DC51778.title": "The Alpha Yeti",
  "quest.50E1175CB81CE47C.quest_desc": [
    "Keeps some of your items when you die.",
  ],
  "quest.50E1175CB81CE47C.title": "Charm of Keeping",
  "quest.55CE117F29E6B322.quest_desc": [
    "The stronghold's soldiers. They drop armor shards.",
  ],
  "quest.55CE117F29E6B322.title": "Goblin Knights",
  "quest.5903AA205C66ADD1.quest_desc": [
    "Up in the clouds stand the houses of the giants.",
  ],
  "quest.5903AA205C66ADD1.title": "Giant's House",
  "quest.597BF8B7684F26A6.quest_desc": [
    "At the top of the Dark Tower floats the Ur-Ghast. Use the ghast traps to bring it down!",
  ],
  "quest.597BF8B7684F26A6.title": "The Ur-Ghast",
  "quest.5E9B93CF34533E96.quest_desc": [
    "Collect the trophy of every boss. Put them on display in your base!",
  ],
  "quest.5E9B93CF34533E96.title": "Trophy Room",
  "quest.645E4CD82371651D.quest_desc": [
    "Deep in the Highlands lie caves full of trolls and giants.",
  ],
  "quest.645E4CD82371651D.title": "Troll Caves",
  "quest.679D6FB708559C0F.quest_desc": [
    "Fiery armor burns attackers.",
  ],
  "quest.679D6FB708559C0F.title": "Fiery Gear",
  "quest.6AA4A175C72AAB77.quest_desc": [
    "Saves you from death once.",
  ],
  "quest.6AA4A175C72AAB77.title": "Charm of Life",
  "quest.6F5951E0AB468774.quest_desc": [
    "The Lich hides behind shields and throws fireballs. Hit the fireballs back at him!",
    "",
    "Later in the fight, he summons minions and comes at you with his sword.",
  ],
  "quest.6F5951E0AB468774.title": "The Lich",
  "quest.7008A7ABC8C1751A.quest_desc": [
    "A mushroom minotaur that charges at you. Dodge, then hit back!",
  ],
  "quest.7008A7ABC8C1751A.title": "The Minoshroom",
  "quest.70E88C36BC2D0CB3.quest_desc": [
    "The boss order:",
    "1. &eNaga&r (Naga Courtyard)",
    "2. &eLich&r (Lich Tower)",
    "3. &eMinoshroom&r (Labyrinth, under the swamp)",
    "4. &eHydra&r (Fire Swamp)",
    "5. &eKnight Phantoms&r (Goblin Stronghold)",
    "6. &eUr-Ghast&r (Dark Tower)",
    "7. &eAlpha Yeti&r (Yeti Cave)",
    "8. &eSnow Queen&r (Aurora Palace)",
    "9. The Highlands and the Final Castle...",
  ],
  "quest.70E88C36BC2D0CB3.title": "The Path",
  "quest.7208AB1BD48791F4.quest_desc": [
    "Also pre-enchanted.",
  ],
  "quest.7208AB1BD48791F4.title": "Steeleaf Gear",
  "quest.72C183346BABFDF7.quest_desc": [
    "A giant mushroom you can climb.",
  ],
  "quest.72C183346BABFDF7.title": "Mushroom Tower",
  "quest.74E94DE858E212A0.quest_desc": [
    "Dig a &e2x2 pool of water&r, surround it with &eflowers&r (and grass), and throw a &bdiamond&r in. Lightning strikes and the portal opens!",
    "",
    "&2The Twilight Forest&r is full of bosses that must be defeated &ein order&r. Areas you have not unlocked yet are protected by curses, darkness and barriers.",
  ],
  "quest.74E94DE858E212A0.quest_subtitle": "The adventure dimension",
  "quest.74E94DE858E212A0.title": "Into the Twilight",
  "quest.761E4637D18F54CC.quest_desc": [
    "Craft iron, moss and liveroot into raw ironwood, then smelt it. Ironwood tools and armor repair themselves.",
  ],
  "quest.761E4637D18F54CC.title": "Ironwood",
  "quest.76341EB8C226671B.quest_desc": [
    "Below the swamp lies a huge stone labyrinth.",
  ],
  "quest.76341EB8C226671B.title": "Labyrinth",
  "quest.77A71D32C3071219.quest_desc": [
    "Ravens gather near stone obelisks. Their feathers make map foci.",
  ],
  "quest.77A71D32C3071219.title": "Raven Feathers",
  "quest.7C68418D4CE9CA23.quest_desc": [
    "A giant serpent. Dodge its charges and strike its head. It drops Naga Scales.",
  ],
  "quest.7C68418D4CE9CA23.title": "The Naga",
  "quest.7E0C184A07C72C72.quest_desc": [
    "Keep track of the moon phase and the time.",
  ],
  "quest.7E0C184A07C72C72.title": "Moon Dial \\& Watch",
  "quest.7F9DF56774421835.quest_desc": [
    "Takes crafted items apart, keeping enchantments as books (for a cost in XP).",
  ],
  "quest.7F9DF56774421835.title": "Uncrafting Table",
  "task.19C641A4FD059486.title": "8 Knightmetal Ingots (any mod)",
}
