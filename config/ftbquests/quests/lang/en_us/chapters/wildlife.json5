  "quest.14B7900208D51C19.quest_desc": [
    "Murks attack from range in warm oceans. Defeat three.",
  ],
  "quest.14B7900208D51C19.title": "Murk",
  "quest.1C6550849CF8FBC6.quest_desc": [
    "A monster of the frozen lands. Defeat three.",
  ],
  "quest.1C6550849CF8FBC6.title": "Gelid",
  "quest.25955A16B0898EB3.quest_desc": [
    "Penguins waddle around snowy plains, slopes and beaches.",
  ],
  "quest.25955A16B0898EB3.title": "Snowy Lands",
  "quest.25EB0F72EAC8964C.quest_desc": [
    "Elephants, giraffes, lions, ostriches and peacocks live in the &esavanna&r. Watch out for the lions!",
  ],
  "quest.25EB0F72EAC8964C.title": "Savanna Safari",
  "quest.2AF5366288300E86.quest_desc": [
    "Little mushroom creatures that only live on mushroom islands.",
  ],
  "quest.2AF5366288300E86.title": "Shroomies",
  "quest.2D0EDDF7E9C390CA.quest_desc": [
    "Savanna animals drop meat you can cook in a furnace, smoker or on a campfire.",
  ],
  "quest.2D0EDDF7E9C390CA.title": "Safari Cooking",
  "quest.302F9F180BAFEFF7.quest_desc": [
    "A jungle monster that attacks from range. Defeat three.",
  ],
  "quest.302F9F180BAFEFF7.title": "Verdant",
  "quest.33705DC19CF2FAFC.quest_desc": [
    "Crabs live on beaches, rivers and swamps. They drop crab meat and shells.",
  ],
  "quest.33705DC19CF2FAFC.title": "Beachcombing",
  "quest.4136CCBEA3C9E6EE.quest_desc": [
    "Ostriches build nests and lay their eggs in them. You can also ride an ostrich.",
  ],
  "quest.4136CCBEA3C9E6EE.title": "Ostrich Egg",
  "quest.5A46FB9FC579710C.quest_desc": [
    "Monkeys and koalas live in the &ejungle&r. Monkeys drop bananas.",
  ],
  "quest.5A46FB9FC579710C.title": "Jungle Friends",
  "quest.5B418D72991F4D39.quest_desc": [
    "Small dragons can be found on the end stone of The End. They drop chorus fruit and ender pearls.",
  ],
  "quest.5B418D72991F4D39.title": "Baby Ender Dragon",
  "quest.6CE077A054400D68.quest_desc": [
    "Catch a seahorse in a bucket. They live in the warmer oceans, and sometimes drop coral or even a Heart of the Sea.",
  ],
  "quest.6CE077A054400D68.title": "Seahorse",
  "quest.6F6C62A4D354D980.quest_desc": [
    "&bLiving Things&r adds lots of new animals all over the world.",
    "",
    "The &eLexicon&r is its guide book: craft it from a &eBook&r and &eLapis Lazuli&r and read about every creature.",
  ],
  "quest.6F6C62A4D354D980.quest_subtitle": "A field guide to new animals",
  "quest.6F6C62A4D354D980.title": "The Lexicon",
  "quest.71176428CCAF2770.quest_desc": [
    "A jungle monster that fights up close. Defeat three.",
  ],
  "quest.71176428CCAF2770.title": "Thicket",
  "quest.73B4BBA8EBDDE787.quest_desc": [
    "&bVariants \\& Ventures&r adds four new monsters, each in its own kind of biome:",
    "- &eGelid&r: frozen, icy and snowy biomes",
    "- &eMurk&r: warm and lukewarm oceans",
    "- &eThicket&r and &eVerdant&r: jungles",
    "",
    "They can also appear in the spawners of &eTrial Chambers&r.",
  ],
  "quest.73B4BBA8EBDDE787.title": "Variants \\& Ventures",
  "quest.7A3AF91E21DBCE56.quest_desc": [
    "You have defeated every new monster. Well done!",
