  ],
  "quest.483E6C98A196C51E.title": "The Undershale",
  "quest.48C52E92081D07B2.quest_desc": [
    "Slippery sand found at the edges of islands. Smelt it into glass.",
  ],
  "quest.48C52E92081D07B2.title": "Quicksoil",
