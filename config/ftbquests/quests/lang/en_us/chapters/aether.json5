  "quest.495781D75F076527.title": "Aether Weapons",
  "quest.4E00D3B66F49C793.quest_desc": [
    "Play the Aether's beautiful music discs.",
  ],
  "quest.4E00D3B66F49C793.title": "Sky Music",
  "quest.4EC198FA7D868FAB.quest_desc": [
    "&bThe Aether II&r is a dimension of floating islands high above the clouds.",
    "",
    "Check JEI for the &eAether portal frame&r and how to activate it, then step through!",
    "",
    "&7Note: The Aether II is still in alpha, so some things may still change between updates.&r",
  ],
  "quest.4EC198FA7D868FAB.quest_subtitle": "The Highlands await",
  "quest.4EC198FA7D868FAB.title": "Into the Sky",
  "quest.4ED1ADB013E6B44F.quest_desc": [
    "Falling off an island drops you into the void, or back to the Overworld if you are lucky.",
    "",
    "Carry &eCold Aerclouds&r to break your fall, and make a &eglider&r as soon as you can.",
  ],
  "quest.4ED1ADB013E6B44F.title": "Mind the Gap",
  "quest.4EE2A44DDC19278B.quest_desc": [
    "Thick skyroot forests.",
  ],
  "quest.4EE2A44DDC19278B.title": "Verdant Woods",
  "quest.4F9DC173E5D3A968.quest_desc": [
    "The Aether's stone.",
  ],
  "quest.4F9DC173E5D3A968.title": "Holystone",
