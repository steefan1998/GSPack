    "The ruins of an ancient Aether civilisation.",
  ],
  "quest.242C8BB68DEA1A7E.title": "Veradexian Ruins",
  "quest.24CFF793D067A4CE.quest_desc": [
    "Collect more charms.",
  ],
  "quest.24CFF793D067A4CE.title": "Charm Collector",
  "quest.281B527F0BECC49E.quest_desc": [
    "A strange, metallic landscape where magnets pull at your gear.",
  ],
  "quest.281B527F0BECC49E.title": "Magnetic Scar",
  "quest.286359BC0464235B.quest_desc": [
