  "quest.2C620CD9B6F9C10D.title": "Zanite",
  "quest.30378A5D9BE09CF6.quest_desc": [
    "Tall purple-tinted woods.",
  ],
  "quest.30378A5D9BE09CF6.title": "Violet Highwoods",
  "quest.30B1BDC14B01DC82.quest_desc": [
    "A magical tea brewed from Valkyrie Sprouts.",
  ],
  "quest.30B1BDC14B01DC82.title": "Valkyrie Tea",
  "quest.3284496F03F84DBF.quest_desc": [
    "Lead animals around.",
  ],
  "quest.3284496F03F84DBF.title": "Lasso",
