  "quest.39ED542D50B4FECF.title": "Aerclouds",
  "quest.3AE3D5FFCA2ED68A.quest_desc": [
    "&eArkenium&r ore lies in the Undershale. Process it into plates.",
    "",
    "The &eArkenium Forge&r is where you upgrade and reinforce your gear.",
  ],
  "quest.3AE3D5FFCA2ED68A.title": "Arkenium",
  "quest.3BA2D1D8DEB70474.quest_desc": [
    "Some chests bite back...",
  ],
  "quest.3BA2D1D8DEB70474.title": "Not a Chest",
  "quest.444BB976FD23C4F6.quest_desc": [
    "Heal yourself and cure poison and other status effects.",
  ],
  "quest.444BB976FD23C4F6.title": "Healing Stone",
  "quest.44C7209DC3B8592D.quest_desc": [
    "Another lost people left these ruins behind.",
  ],
  "quest.44C7209DC3B8592D.title": "Brexallen Ruins",
  "quest.451357EE19737D9C.quest_desc": [
    "Strange creatures of the deep places.",
  ],
  "quest.451357EE19737D9C.title": "Skephids",
  "quest.476AF39EA0F8E76A.quest_desc": [
    "Ambrosium is the Aether's fuel and light source. It can also heal you a little.",
  ],
  "quest.476AF39EA0F8E76A.title": "Ambrosium",
  "quest.483C3D3EB99CF700.quest_desc": [
    "Blueberries, oranges and wyndberries grow on the islands.",
  ],
  "quest.483C3D3EB99CF700.title": "Sky Food",
