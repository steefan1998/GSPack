  "quest.34CD3206C9EFC260.title": "Altar",
  "quest.358EB5280D943513.quest_desc": [
    "A small flying boat for long trips.",
  ],
  "quest.358EB5280D943513.title": "Cloud Skiff",
  "quest.387041C7539E83D2.quest_desc": [
    "Some Aether creatures are toxic or venomous. Carry the cure!",
  ],
  "quest.387041C7539E83D2.title": "Antidotes",
  "quest.3982750FC2FB407F.quest_desc": [
