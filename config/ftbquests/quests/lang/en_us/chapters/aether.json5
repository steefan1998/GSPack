  ],
  "quest.121A8CD4C11E9B78.title": "Zanite Tools",
  "quest.14CB7ECD3FA04787.quest_desc": [
    "Wide frozen plains.",
  ],
  "quest.14CB7ECD3FA04787.title": "Sheer Tundra",
  "quest.1BC1153E9B8EA840.quest_desc": [
    "Old mineshafts in the Undershale.",
  ],
  "quest.1BC1153E9B8EA840.title": "Undercloud Mineshaft",
  "quest.1DAD469FDE3B0B4D.quest_desc": [
