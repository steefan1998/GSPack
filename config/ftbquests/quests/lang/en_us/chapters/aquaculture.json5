  "quest.40674E8A173A6DD1.title": "Worm Farm",
  "quest.42176234ED52E201.quest_desc": [
    "A hearty soup.",
  ],
  "quest.42176234ED52E201.title": "Turtle Soup",
  "quest.448B432139D20BF0.quest_desc": [
    "The redstone hook gives you more time to reel in a fish. The note hook plays an alert when a fish is approaching.",
  ],
  "quest.448B432139D20BF0.title": "Special Hooks",
  "quest.47FE050D1E620472.quest_desc": [
    "A sea metal used for powerful gear.",
  ],
  "quest.47FE050D1E620472.title": "Neptunium",
  "quest.48AAADF6F760D852.quest_desc": [
    "You have caught every type of fish. A true Master Angler!",
