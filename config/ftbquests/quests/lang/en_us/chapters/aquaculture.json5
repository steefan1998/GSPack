  "quest.5725EBA92DB30330.title": "Goldfish",
  "quest.646AAF9C7BF9C9DD.quest_desc": [
    "Jungle rivers and lakes. Watch your fingers!",
  ],
  "quest.646AAF9C7BF9C9DD.title": "Jungle Rivers",
  "quest.649652F53E84C3D6.quest_desc": [
    "Fillets wrapped in algae. Delicious!",
  ],
  "quest.649652F53E84C3D6.title": "Sushi",
  "quest.68B39C312E1DC490.quest_desc": [
    "These fish live in savanna and desert rivers and lakes.",
  ],
  "quest.68B39C312E1DC490.title": "African Waters",
  "quest.6A563D311337982B.quest_desc": [
    "Read it! Who sent this?",
  ],
  "quest.6A563D311337982B.title": "Message in a Bottle",
  "quest.6C44F28133A89989.quest_desc": [
    "Has a chance to catch two things at once!",
  ],
  "quest.6C44F28133A89989.title": "Double Hook",
  "quest.6F792E1D824D4CD6.quest_desc": [
    "- &eIron Hook&r: 20% chance not to use rod durability.",
    "- &eGold Hook&r: more luck, for better catches.",
  ],
  "quest.6F792E1D824D4CD6.title": "Hooks",
  "quest.774FF50ED4370008.quest_desc": [
    "&bAquaculture 2&r adds new fishing rods, tackle, and over 30 fish that each live in their own biomes.",
    "",
    "Craft an &eIron Fishing Rod&r. Better rods last longer and can hold more tackle.",
    "",
    "&6Tip:&r Every fish can be caught alive in a bucket, and most can be filleted for food.",
  ],
  "quest.774FF50ED4370008.quest_subtitle": "A fish for every biome",
  "quest.774FF50ED4370008.title": "Gone Fishing",
  "quest.78946FA8971ADEBA.quest_desc": [
    "Not really a fish, but it counts! Jellyfish can be caught in any ocean or on a beach.",
  ],
  "quest.78946FA8971ADEBA.title": "Jellyfish",
  "quest.7A8A2CA687430EBF.quest_desc": [
    "A big, rare predatory fish of rivers and lakes. It bites in fresh water anywhere except hot biomes, deserts and jungles.",
  ],
  "quest.7A8A2CA687430EBF.title": "Muskellunge",
  "quest.7F0907D8078A5B49.quest_desc": [
    "Scoop a live fish into a bucket. Put it in an aquarium!",
  ],
  "quest.7F0907D8078A5B49.title": "Catch and Release",
