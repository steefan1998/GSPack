  "chapter.3F4B3E9631DE14D7.title": "Aquaculture 2",
  "quest.021B2F53136B3481.quest_desc": [
    "Big flat fish. Atlantic halibut bite in oceans and on beaches that are not hot; Pacific halibut only in &ecold oceans&r and on cold beaches.",
  ],
  "quest.021B2F53136B3481.title": "Halibut",
  "quest.074BB561B0C57477.quest_desc": [
    "One of the best hooks: a 50% chance not to use rod durability.",
  ],
  "quest.074BB561B0C57477.title": "Diamond Hook",
  "quest.0765AD5FFA825D9F.quest_desc": [
    "Atlantic herring bite in any ocean that is not hot. Atlantic cod and pollock only bite in &ecold oceans&r and on cold beaches.",
  ],
  "quest.0765AD5FFA825D9F.title": "Ocean Fish",
  "quest.094DD1EA7A617D1C.quest_desc": [
    "Also found in temperate waters. Minnows make great bait for bigger fish.",
  ],
  "quest.094DD1EA7A617D1C.title": "Carp \\& Minnow",
  "quest.0AD7EC7C443B4E07.quest_desc": [
    "Place your rod in the Tackle Box to change its:",
    "- &eHook&r: special effects.",
    "- &eBait&r: catch fish faster.",
    "- &eFishing Line&r: colour.",
    "- &eBobber&r: colour.",
  ],
  "quest.0AD7EC7C443B4E07.title": "Tackle Box",
  "quest.1305A4670790DD25.quest_desc": [
    "Found in cold waters: cold rivers, beaches and oceans.",
  ],
  "quest.1305A4670790DD25.title": "Pink Salmon",
  "quest.14A1D55B22A1602D.quest_desc": [
    "Not everything you catch is a fish. Some junk can be crafted into useful things.",
  ],
  "quest.14A1D55B22A1602D.title": "Junk",
  "quest.1DA2A3DA85F0D8E3.quest_desc": [
    "Show off your best catches on the wall.",
  ],
  "quest.1DA2A3DA85F0D8E3.title": "Fish Mount",
  "quest.1EE1334A3434CEC8.quest_desc": [
    "Blackfish only bite in &ecold oceans&r and on &ecold beaches&r. Rainbow trout live there too, and also in rivers outside hot biomes.",
  ],
  "quest.1EE1334A3434CEC8.title": "Cold Waters",
  "quest.20F9AB53A4D695C7.quest_desc": [
    "Breathe and move freely underwater.",
  ],
  "quest.20F9AB53A4D695C7.title": "Neptunium Armor",
  "quest.2538A5FBCEDEC4A9.quest_desc": [
    "Box turtles are fished in swamps, arrau turtles in jungles, and starshell turtles in &2The Twilight Forest&r. All three are rare.",
  ],
  "quest.2538A5FBCEDEC4A9.title": "Turtles",
  "quest.25D619A250B95BFD.quest_desc": [
    "Red grouper and tuna bite in &eany ocean&r and on beaches. Tuna are rare, so keep at it!",
  ],
  "quest.25D619A250B95BFD.title": "Big Ocean Fish",
  "quest.2C98AA08BDD35444.quest_desc": [
    "Fires arrows that fly straight underwater.",
  ],
  "quest.2C98AA08BDD35444.title": "Neptunium Bow",
  "quest.2E9D9B0ED1913D4A.quest_desc": [
    "The ultimate hook: a 50% chance not to use rod durability and more luck. It needs a Nether Star.",
  ],
  "quest.2E9D9B0ED1913D4A.title": "Nether Star Hook",
  "quest.366DDF43B00D1F38.quest_desc": [
    "A light hook casts further, a heavy hook casts shorter.",
  ],
  "quest.366DDF43B00D1F38.title": "Light \\& Heavy",
  "quest.37B7D47BFBE38314.quest_desc": [
    "Bigger freshwater fish of rivers, lakes and swamps. They do not bite in deserts, snowy biomes or jungles, and largemouth bass also avoid cold biomes. Catfish are rare.",
  ],
  "quest.37B7D47BFBE38314.title": "Lake Fish",
  "quest.38D2A41D591940A4.quest_desc": [
    "The &eLeech&r (and the Box Turtle) can only be fished in &eswamps&r.",
  ],
  "quest.38D2A41D591940A4.title": "Swamp Dwellers",
  "quest.39B4D7531A4ADC9E.quest_desc": [
    "Cook the fillets for a filling meal.",
  ],
  "quest.39B4D7531A4ADC9E.title": "Fish Fillets",
  "quest.3AB2B172A90B6995.quest_desc": [
    "Gold rods are more enchantable.",
  ],
  "quest.3AB2B172A90B6995.title": "Gold Rod",
  "quest.3BAF97A3FB4A0A45.quest_desc": [
    "Break dirt or grass and you will sometimes find worms. Bait makes fish bite faster.",
  ],
  "quest.3BAF97A3FB4A0A45.title": "Worms",
  "quest.3D8FEF7156CA8CD7.quest_desc": [
    "The best fillet knife gives the most fillets.",
  ],
  "quest.3D8FEF7156CA8CD7.title": "Neptunium Knife",
  "quest.3F0A5D742CD3824B.quest_desc": [
