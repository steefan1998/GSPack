  ],
  "quest.4ED77B1D96C17159.title": "Neptune's Bounty",
  "quest.4F2BE9966CFED966.quest_desc": [
    "These strange fungal fish live around mushroom islands. Finding one is the hard part!",
  ],
  "quest.4F2BE9966CFED966.title": "Shroomas",
  "quest.502D3E3FD9B95E23.quest_desc": [
    "Boxes found while fishing hold loot. Right-click them to open.",
  ],
  "quest.502D3E3FD9B95E23.title": "Boxes",
  "quest.5114D3CA37D6DAF3.quest_desc": [
    "The best fishing rod in the game.",
  ],
  "quest.5114D3CA37D6DAF3.title": "Neptunium Rod",
  "quest.5725EBA92DB30330.quest_desc": [
    "Goldfish are not caught like normal fish: they turn up as &ejunk&r, in any biome. Keep fishing! A goldfish can be crafted into a gold nugget, or shown off in a fish mount.",
