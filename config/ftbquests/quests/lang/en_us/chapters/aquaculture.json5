  "quest.48AAADF6F760D852.title": "Master Angler",
  "quest.498DCFDB70D41373.quest_desc": [
    "A very durable rod.",
  ],
  "quest.498DCFDB70D41373.title": "Diamond Rod",
  "quest.4A1A31BF5C2ACEB1.quest_desc": [
    "Dye them for a personal touch.",
  ],
  "quest.4A1A31BF5C2ACEB1.title": "Line \\& Bobber",
  "quest.4B221C84F499745C.quest_desc": [
    "Algae grows in swamps and can be fished up.",
  ],
  "quest.4B221C84F499745C.title": "Algae",
  "quest.4B9A7D008B5EA0CF.quest_desc": [
    "A rare catch with great loot inside.",
  ],
  "quest.4B9A7D008B5EA0CF.title": "Treasure Chest",
