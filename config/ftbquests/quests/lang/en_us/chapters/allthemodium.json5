{
  "chapter.02316B1978EB3F28.chapter_subtitle": [
    "The rarest metals: Allthemodium, Vibranium and Unobtainium."
  ],
  "chapter.02316B1978EB3F28.title": "Allthemodium",
  "quest.007609499F487CA7.quest_desc": [
    "A whole world made for mining. Ores are much more common here, and nobody minds if you dig huge holes.",
    "",
    "&6Tip:&r Set a waypoint at your teleport pad so you can find it again!"
  ],
  "quest.007609499F487CA7.title": "The Mining Dimension",
  "quest.0C101DBD763CAC83.quest_desc": [
    "Very strong armor. The full set gives protection against things like fall damage and drowning."
  ],
  "quest.0C101DBD763CAC83.title": "Allthemodium Armor",
  "quest.11A8C30AC3CECC14.quest_desc": [
    "A village full of piglins in The Other."
  ],
  "quest.11A8C30AC3CECC14.title": "Piglin Village",
  "quest.132D13DCD2E00508.quest_desc": [
    "The heart of the Piglich."
  ],
  "quest.132D13DCD2E00508.title": "Piglich Heart",
  "quest.17AE580430EA1BA9.quest_desc": [
    "Unobtainium ore sits in the &eend stone&r of the End Highlands, near the surface of the islands. You need a &5Vibranium&r pickaxe to mine it."
  ],
  "quest.17AE580430EA1BA9.title": "Unobtainium",
  "quest.19DA9C03A4B9B8C9.quest_desc": [
    "Collect some of The Other's ancient blocks."
  ],
  "quest.19DA9C03A4B9B8C9.title": "Ancient Wood",
  "quest.25E115436FA942F0.quest_desc": [
    "A block of each metal. You have conquered Allthemodium!"
  ],
  "quest.25E115436FA942F0.title": "Allthemodium Master",
  "quest.26CE3EC1BD05459C.quest_desc": [
    "A mighty undead piglin lord. Its heart is a rare crafting material."
  ],
  "quest.26CE3EC1BD05459C.title": "The Piglich",
  "quest.2811939991D9A959.quest_desc": [
    "A dangerous dimension of ancient forests, soul-sand valleys and deep caves. Get there from the Nether with a Teleport Pad.",
    "",
    "&cBe well prepared!&r Bring food, healing and your best armor."
  ],
  "quest.2811939991D9A959.title": "The Other",
  "quest.2AEA6CE1667B72C4.quest_desc": [
    "Stronger still."
  ],
  "quest.2AEA6CE1667B72C4.title": "Vibranium Armor",
  "quest.2C17D7B98A5A38A1.quest_desc": [
    "The top tier of Allthemodium tools."
  ],
  "quest.2C17D7B98A5A38A1.title": "Unobtainium Tools",
  "quest.2D56F28425580D37.quest_desc": [
    "&6Allthemodium&r adds three extremely rare metals, each harder than the last:",
    "1. &6Allthemodium&r: needs a &enetherite&r pickaxe.",
    "2. &5Vibranium&r: needs an &6Allthemodium&r pickaxe.",
    "3. &dUnobtainium&r: needs a &5Vibranium&r pickaxe.",
    "",
    "Where to find them:",
    "- &6Allthemodium&r: the &eDeep Dark&r, the &eMining Dimension&r and &eThe Other&r",
    "- &5Vibranium&r: &eThe Nether&r and &eThe Other&r",
    "- &dUnobtainium&r: the &eEnd Highlands&r, the outer islands of The End",
    "",
    "It also adds three dimensions: the &eMining Dimension&r, &eThe Other&r and &eThe Beyond&r, an empty void world."
  ],
  "quest.2D56F28425580D37.quest_subtitle": "Three metals, three dimensions",
  "quest.2D56F28425580D37.title": "The Hunt Begins",
  "quest.2E088CACC9730C11.quest_desc": [
    "The second rare metal."
  ],
  "quest.2E088CACC9730C11.title": "Vibranium Ingot",
  "quest.31B888B75CB87D5B.quest_desc": [
    "Plants that only grow in The Other."
  ],
  "quest.31B888B75CB87D5B.title": "Strange Herbs",
  "quest.3375F4EC4AFF0516.quest_desc": [
    "Your Allthemodium pickaxe can mine Vibranium."
  ],
  "quest.3375F4EC4AFF0516.title": "Allthemodium Tools",
  "quest.370D2A8434631929.quest_desc": [
    "The &eTeleport Pad&r is your gateway to the Allthemodium dimensions.",
    "",
    "&eSneak + right-click&r the pad to travel. Where it takes you depends on where it is:",
    "- Overworld: the &eMining Dimension&r",
    "- The Nether: &eThe Other&r",
    "- The End: &eThe Beyond&r",
    "",
    "Use a pad on the other side to come back. Look at a pad with Jade to see its target.",
    "",
    "&6GSPack:&r the pad needs a &eZanite Gemstone&r from The Aether II instead of an ender pearl."
  ],
  "quest.370D2A8434631929.title": "Teleport Pad",
  "quest.377F9C458D83E912.quest_desc": [
    "A pickaxe, axe and shovel in one, made of the best alloys. &6GSPack:&r crafted in an &eUltimate Crafting Table&r (9x9) from the Alloy Pickaxe, Axe and Shovel, all three alloys, Compressed Unobtainium-Vibranium Alloy Blocks and Antimatter. Each alloy tool is crafted in an &eElite Crafting Table&r (7x7) around its Unobtainium version."
  ],
  "quest.377F9C458D83E912.title": "Alloy Paxel",
  "quest.3B8BF16702068B30.quest_desc": [
    "Upgrade your Allthemodium gear to Vibranium."
  ],
  "quest.3B8BF16702068B30.title": "Vibranium Template",
  "quest.3D6CDFC350D4F63C.quest_desc": [
    "Smelt the raw ore. Mekanism and Oritech processing work too for extra output!"
  ],
  "quest.3D6CDFC350D4F63C.title": "Allthemodium Ingot",
  "quest.3FF14E6A3F571E9A.quest_desc": [
    "Powerful foods made with Allthemodium."
  ],
  "quest.3FF14E6A3F571E9A.title": "Golden Treats",
  "quest.419D4169C62C4B52.quest_desc": [
    "Allthemodium ore generates in three places:",
    "- The &eDeep Dark&r biome in the Overworld, below Y 10 on cave ceilings.",
    "- The &eMining Dimension&r, between Y 65 and 247 (most common near the bottom of that range).",
    "- &eThe Other&r.",
    "",
    "You need a &enetherite&r pickaxe to mine it."
  ],
  "quest.419D4169C62C4B52.title": "Allthemodium Ore",
  "quest.4511C7EC270D8F97.quest_desc": [
    "Vibranium ore generates in:",
    "- &eThe Nether&r, on cave ceilings between Y 64 and 127.",
    "- &eThe Other&r, in its ancient stone.",
    "",
    "You need an &6Allthemodium&r pickaxe to mine it."
  ],
  "quest.4511C7EC270D8F97.title": "Vibranium",
  "quest.4889B1AC46F33794.quest_desc": [
    "The ultimate weapons. &6GSPack:&r each one is crafted in an &eElite Crafting Table&r (7x7) around its Unobtainium version (or a Trident), with all three alloys, Compressed Unobtainium-Vibranium Alloy Blocks and Antimatter."
  ],
  "quest.4889B1AC46F33794.title": "Alloy Arsenal",
  "quest.49DDCA926E7726A1.quest_desc": [
    "The rarest of the three metals."
  ],
  "quest.49DDCA926E7726A1.title": "Unobtainium Ingot",
  "quest.4B4C95E8260BCB7C.quest_desc": [
    "The final smithing upgrade."
  ],
  "quest.4B4C95E8260BCB7C.title": "Unobtainium Template",
  "quest.5180EDD671308586.quest_desc": [
    "Unobtainium only generates in the &eEnd Highlands&r: the large outer islands of The End.",
    "",
    "Defeat the Ender Dragon, then throw an Ender Pearl into an &eEnd Gateway&r to reach the outer islands. Nullscape gives the outer End a new look, but the End Highlands are still there. Bring blocks, food and slow-falling potions!"
  ],
  "quest.5180EDD671308586.title": "The End Highlands",
  "quest.539482B6DBE7EC6D.quest_desc": [
    "Like netherite, you upgrade gear in the smithing table with a template. Duplicate templates with the material."
  ],
  "quest.539482B6DBE7EC6D.title": "Upgrade Template",
  "quest.5457A2C786671E50.quest_desc": [
    "Bring back a big haul from the Mining Dimension."
  ],
  "quest.5457A2C786671E50.title": "Mining Trip",
  "quest.5561503D368A6EF2.quest_desc": [
    "Fuse the rare metals into the three alloys in a crafting table:",
    "- &e2 Allthemodium + 2 Vibranium&r -> 2 Vibranium-Allthemodium Alloy",
    "- &e2 Unobtainium + 2 Allthemodium&r -> 2 Unobtainium-Allthemodium Alloy",
    "- &e2 Unobtainium + 2 Vibranium&r -> 2 Unobtainium-Vibranium Alloy",
    "",
    "The same works with dusts. Alloy dust smelts into an alloy ingot."
  ],
  "quest.5561503D368A6EF2.title": "Mythic Alloys",
  "quest.557DDBDCD6D3C6B6.quest_desc": [
    "A whole block of Allthemodium. Shiny!"
  ],
  "quest.557DDBDCD6D3C6B6.title": "Show Off",
  "quest.562876CE1CF0C29E.quest_desc": [
    "&eThe Beyond&r is an empty &evoid&r dimension: nothing generates there, no blocks, no ores and no mobs. It is a blank canvas for a sky base or a big build.",
    "",
    "Get there with a &eTeleport Pad&r in The End. Bring your own blocks, and do not fall!"
  ],
  "quest.562876CE1CF0C29E.title": "The Beyond",
  "quest.573DE36DE6AA5220.quest_desc": [
    "Find one of the Allthemodium dungeons."
  ],
  "quest.573DE36DE6AA5220.title": "ATM Dungeon",
  "quest.5C5F951C4D73E632.quest_desc": [
    "Allthemodium storage and backpack upgrades exist for &bSophisticated Storage&r and &bSophisticated Backpacks&r. Check JEI!"
  ],
  "quest.5C5F951C4D73E632.title": "Storage Upgrades",
  "quest.6317871254FF2525.quest_desc": [
    "Ancient pyramids hide treasure. Watch out for traps."
  ],
  "quest.6317871254FF2525.title": "Ancient Pyramid",
  "quest.672DD6DCC1DABDF3.quest_desc": [
    "The best armor of the three metals."
  ],
  "quest.672DD6DCC1DABDF3.title": "Unobtainium Armor",
  "quest.6A4C279013FBDD1A.quest_desc": [
    "Your Vibranium pickaxe can mine Unobtainium."
  ],
  "quest.6A4C279013FBDD1A.title": "Vibranium Tools",
  "quest.6B77958149DD846E.quest_desc": [
    "Only fitting."
  ],
  "quest.6B77958149DD846E.title": "Vibranium Shield",
  "quest.6FE9E9E2D3EF8E23.quest_desc": [
    "Plates, gears and rods for crafting recipes in other mods."
  ],
  "quest.6FE9E9E2D3EF8E23.title": "Allthemodium Parts",
  "quest.7BD00A9B44CA5C9C.quest_desc": [
    "Allthemodium ore generates in the &eDeep Dark&r biome, the home of the Ancient Cities. Look for it below Y 10, hanging from cave ceilings. Sneak, and do not wake the Warden!"
  ],
  "quest.7BD00A9B44CA5C9C.title": "Into the Deep Dark"
}
