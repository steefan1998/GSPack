{
  "chapter.1E4CA1EAB9003DC3.chapter_subtitle": [
    "Living goo, four new metals, time crystals, portal guns and handy machines.",
  ],
  "chapter.1E4CA1EAB9003DC3.title": "Just Dire Things",
  "quest.0040AEC79993EAE9.quest_desc": [
    "Tier 3 goo, upgraded with ender pearls, end stone and dragon's breath.",
  ],
  "quest.0040AEC79993EAE9.title": "VoidShimmer Goo",
  "quest.05537D0305294B4D.quest_desc": [
    "Just Dire Things tools and armor get &eabilities&r from upgrades. Each upgrade starts as a &eBlank Upgrade&r.",
    "",
    "Combine a tool with an upgrade to unlock that ability (check JEI for each one). Better metals unlock more abilities.",
  ],
  "quest.05537D0305294B4D.title": "Blank Upgrade",
  "quest.05A58136CEF100CD.quest_desc": [
    "Right- or left-clicks like a player.",
  ],
  "quest.05A58136CEF100CD.title": "Clicker",
  "quest.0C9E6CE350BDB1F1.quest_desc": [
    "Your first Just Dire Things tools. They can hold &eability upgrades&r.",
  ],
  "quest.0C9E6CE350BDB1F1.title": "Ferricore Tools",
  "quest.0F71EC9F2FC9D5C8.quest_desc": [
    "Picks up items around it.",
  ],
  "quest.0F71EC9F2FC9D5C8.title": "Item Collector",
  "quest.10629AEA2366BB94.quest_desc": [
    "Saves you from dying once in a while. Eclipse Alloy chestplate only.",
  ],
  "quest.10629AEA2366BB94.title": "Death Protection",
  "quest.117D79ADEB394A77.quest_desc": [
    "Burns coal for Forge Energy. Better coal tiers give more power.",
  ],
  "quest.117D79ADEB394A77.title": "Coal Generator",
  "quest.12484EE6A32C849B.quest_desc": [
    "Burns fuel in your inventory to charge the powered tools you carry.",
  ],
  "quest.12484EE6A32C849B.title": "Pocket Generator",
  "quest.131F81E0625949F3.quest_desc": [
    "Tier 4 goo, upgraded with sculk, a sculk shrieker and echo shards from the Deep Dark.",
  ],
  "quest.131F81E0625949F3.title": "Shadowpulse Goo",
  "quest.15455EAAD1E8A21D.quest_desc": [
    "Tier 2 goo, upgraded with blaze powder, redstone and nether wart.",
  ],
  "quest.15455EAAD1E8A21D.title": "Blazebloom Goo",
  "quest.1A306B210BA2F0CE.quest_desc": [
    "Upgrade Ferricore tools with a &eBlazegold Template&r in a Smithing Table, or craft them new. They hold more abilities.",
  ],
  "quest.1A306B210BA2F0CE.title": "Blazegold Tools",
  "quest.1C2D65197B62C2AA.quest_desc": [
    "Breaks the block in front of it. The tier 2 versions use power and can work on an area.",
  ],
  "quest.1C2D65197B62C2AA.title": "Block Breaker",
  "quest.1DFADAD084B7DC09.quest_desc": [
    "Catch a mob and release it somewhere else.",
  ],
  "quest.1DFADAD084B7DC09.title": "Creature Catcher",
  "quest.21D7707052785FE1.quest_desc": [
    "Drop a Portal Fluid Catalyst into Polymorphic Fluid, then let VoidShimmer Goo stabilise it. Upgrades the Portal Gun.",
  ],
  "quest.21D7707052785FE1.title": "Portal Fluid",
  "quest.2200B95AABBDB068.quest_desc": [
    "Ore Miner mines a whole vein (from Ferricore), Hammer mines a 3x3 area (from Blazegold).",
  ],
  "quest.2200B95AABBDB068.title": "Mining Abilities",
  "quest.23B57B2DB9B34547.quest_desc": [
    "Stores experience, and can collect it from the ground.",
  ],
  "quest.23B57B2DB9B34547.title": "Experience Holder",
  "quest.2579A1468E14A08E.quest_desc": [
    "A full set of Ferricore armor.",
  ],
  "quest.2579A1468E14A08E.title": "Ferricore Armor",
  "quest.25EA5839701D2F55.quest_desc": [
    "The best fuel: each tier of coal block is upgraded by the next goo tier.",
  ],
  "quest.25EA5839701D2F55.title": "Coal T4",
  "quest.281CA117FD4FB6A8.quest_desc": [
    "Sends power wirelessly to machines around it.",
  ],
  "quest.281CA117FD4FB6A8.title": "Energy Transmitter",
  "quest.283077DA1AD108D8.quest_desc": [
    "Primogel Goo (or better) turns an &eiron block&r into Raw Ferricore Ore. Mine it for Raw Ferricore.",
  ],
  "quest.283077DA1AD108D8.title": "Ferricore",
  "quest.28856CD4186C06B7.quest_desc": [
    "The strongest tools, with room for every ability.",
  ],
  "quest.28856CD4186C06B7.title": "Eclipse Alloy Tools",
  "quest.2D9648F58216A9D1.quest_desc": [
    "Gives a redstone signal when it sees a certain block or entity.",
  ],
  "quest.2D9648F58216A9D1.title": "Sensor",
  "quest.2DB8AE43ABAB9872.quest_desc": [
    "&bJust Dire Things&r starts with &eGoo&r: a living block that slowly turns the blocks next to it into something new.",
    "",
    "Craft &ePrimogel Goo&r from clay, sugar, rotten flesh and dirt. Place it, put the right block against it and wait. Used goo can become &eExhausted&r. JEI shows every conversion under &eGoo Spreading Recipes&r.",
    "",
    "Every tier of goo can transform better blocks.",
  ],
  "quest.2DB8AE43ABAB9872.quest_subtitle": "It is alive!",
  "quest.2DB8AE43ABAB9872.title": "Primogel Goo",
  "quest.2EE56E4DB7D847BA.quest_desc": [
    "Swaps blocks in the world for other blocks, like a building gadget.",
  ],
  "quest.2EE56E4DB7D847BA.title": "Polymorphic Wand",
  "quest.30F1155C8BBB7457.quest_desc": [
    "VoidShimmer Goo (or better) turns a &ediamond block&r into Raw Celestigem Ore. Celestigem Seeds (Seed Codex) can grow it too.",
  ],
  "quest.30F1155C8BBB7457.title": "Celestigem",
  "quest.31CBDF9E32AE45A8.quest_desc": [
    "Rotates blocks and picks up Just Dire Things machines.",
  ],
  "quest.31CBDF9E32AE45A8.title": "Ferricore Wrench",
  "quest.350F2183504429CB.quest_desc": [
    "Blazebloom Goo (or better) turns a &egold block&r into Raw Blazegold Ore.",
  ],
  "quest.350F2183504429CB.title": "Blazegold",
  "quest.356EC53324F781A2.quest_desc": [
    "Places blocks in front of it.",
  ],
  "quest.356EC53324F781A2.title": "Block Placer",
  "quest.363D1372EC2AFA63.quest_desc": [
    "Smelt the raw blazegold. Blazegold Seeds (Seed Codex) can grow it too.",
  ],
  "quest.363D1372EC2AFA63.title": "Blazegold Ingot",
  "quest.372CD375C0DE281C.quest_desc": [
    "Takes you back to where you last died.",
  ],
  "quest.372CD375C0DE281C.title": "Totem of Death Recall",
  "quest.37D22BFF0B172D01.quest_desc": [
    "Launches you forward in a burst of fire.",
  ],
  "quest.37D22BFF0B172D01.title": "Blazejet Wand",
  "quest.3983C0E6985A4ABC.quest_desc": [
    "Shoot two portals and walk between them. Made from blazegold and an eye of ender.",
  ],
  "quest.3983C0E6985A4ABC.title": "Portal Gun",
  "quest.3B6CCC6103F167C8.quest_desc": [
    "Armor that can even hold a flight upgrade.",
  ],
  "quest.3B6CCC6103F167C8.title": "Celestigem Armor",
  "quest.4771F464A289A321.quest_desc": [
    "The best armor in Just Dire Things.",
  ],
  "quest.4771F464A289A321.title": "Eclipse Alloy Armor",
  "quest.47B843500123473C.quest_desc": [
    "Pick up and place fluids automatically.",
  ],
  "quest.47B843500123473C.title": "Fluid Machines",
  "quest.4B23044D0ED94473.quest_desc": [
    "The best metal in Just Dire Things. Eclipse Alloy Seeds (Seed Codex) can grow it too.",
  ],
  "quest.4B23044D0ED94473.title": "Eclipse Alloy Ingot",
  "quest.4BEEE72F4D1DC155.quest_desc": [
    "Shadowpulse Goo turns a &enetherite block&r into Raw Eclipse Alloy Ore.",
  ],
  "quest.4BEEE72F4D1DC155.title": "Eclipse Alloy",
  "quest.4F7636CB9613188B.quest_desc": [
    "Drop Coal T2 into Polymorphic Fluid for unrefined fuel, then let goo refine it. Higher coal tiers make better fuel.",
  ],
  "quest.4F7636CB9613188B.title": "Refined Fuel",
  "quest.5340DA8FF01C3911.quest_desc": [
    "Smelts what you mine.",
  ],
  "quest.5340DA8FF01C3911.title": "Auto Smelt",
  "quest.562EACA985C07242.quest_desc": [
    "Time Crystals grow from a budding block, like amethyst. Check JEI for how to get the first one.",
  ],
  "quest.562EACA985C07242.title": "Time Crystal",
  "quest.5673D6477D7B08D2.quest_desc": [
    "Saves an area and can restore it later. The final machine of Just Dire Things.",
  ],
  "quest.5673D6477D7B08D2.title": "Paradox Machine",
  "quest.57CAFA0220F64D2F.quest_desc": [
    "Temporarily removes blocks to open a passage, then puts them back.",
  ],
  "quest.57CAFA0220F64D2F.title": "Eclipse Gate Wand",
  "quest.583CEA5BA3F19A56.quest_desc": [
    "Burns refined fuel for power.",
  ],
  "quest.583CEA5BA3F19A56.title": "Fluid Generator",
  "quest.5F8FF862F9B5DA8B.quest_desc": [
    "Smelt the raw ferricore. Ferricore Seeds (Seed Codex) can grow it too.",
  ],
  "quest.5F8FF862F9B5DA8B.title": "Ferricore Ingot",
  "quest.6508D4E10BFA5D63.quest_desc": [
    "Farmland made from goo: crops on it grow faster. Every goo tier has its own soil.",
  ],
  "quest.6508D4E10BFA5D63.title": "Goo Soil",
  "quest.674C5EDFECAD24FE.quest_desc": [
    "Tier 2 machines run on power, work faster and can be set to an area.",
  ],
  "quest.674C5EDFECAD24FE.title": "Powered Machines",
  "quest.68CE15E75BE113D6.quest_desc": [
    "Drop a Time Crystal into Polymorphic Fluid.",
  ],
  "quest.68CE15E75BE113D6.title": "Time Fluid",
  "quest.6B9A14919C41C9F2.quest_desc": [
    "Even better tools, including a &ePaxel&r (pickaxe, axe and shovel in one).",
  ],
  "quest.6B9A14919C41C9F2.title": "Celestigem Tools",
  "quest.705693FCCE7139A1.quest_desc": [
    "For leggings and boots: walk faster, jump higher and step up full blocks.",
  ],
  "quest.705693FCCE7139A1.title": "Movement Abilities",
  "quest.70EB4E751139A5BF.quest_desc": [
    "Drop a &ePolymorphic Catalyst&r into still water to turn it into Polymorphic Fluid. It is the base of every other Just Dire Things fluid.",
  ],
  "quest.70EB4E751139A5BF.title": "Polymorphic Fluid",
  "quest.72F1BACCB3FE2661.quest_desc": [
    "Speeds up the block you point it at, using Time Fluid.",
  ],
  "quest.72F1BACCB3FE2661.title": "Time Wand",
  "quest.7A0DB9103E611EED.quest_desc": [
    "Walk through walls: shift a few blocks through solid ground.",
  ],
  "quest.7A0DB9103E611EED.title": "Voidshift Wand",
  "quest.7C32AA9DE5B4107E.quest_desc": [
    "Fire-proof armor with room for movement upgrades.",
  ],
  "quest.7C32AA9DE5B4107E.title": "Blazegold Armor",
  "quest.7C93E21A3F19FF1C.quest_desc": [
    "Creative-style flight for an Eclipse Alloy chestplate.",
  ],
  "quest.7C93E21A3F19FF1C.title": "Flight",
  "quest.7CDFB36B68738CF2.quest_desc": [
    "Goo turns coal (or charcoal) blocks into &eCoal T1&r ore. Its coal burns longer, and every goo tier upgrades it further.",
  ],
  "quest.7CDFB36B68738CF2.title": "Better Coal",
  "quest.7FA6FE8C5C7CD866.quest_desc": [
    "Chops down a whole tree at once.",
  ],
  "quest.7FA6FE8C5C7CD866.title": "Tree Feller",
}
