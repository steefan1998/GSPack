{
  "chapter.36A46344FB72D9F5.chapter_subtitle": [
    "The road through the pack: from your first crafting table to the Trophy of Infinity.",
  ],
  "chapter.36A46344FB72D9F5.title": "GSPack Progression",
  "quest.040ECB00C94BF973.quest_desc": [
    "A diamond pickaxe opens up the rest of the pack. Choose a road, or try all three!",
  ],
  "quest.040ECB00C94BF973.title": "Diamonds!",
  "quest.07CEC09293A330D4.quest_desc": [
    "Defeat the Ender Dragon. See &eGetting Started&r.",
  ],
  "quest.07CEC09293A330D4.title": "The End",
  "quest.09B4200D6A64399A.quest_desc": [
    "Tier 6 crops and their Crux blocks, including the Allthemodium seeds. See &eMystical Agriculture&r.",
  ],
  "quest.09B4200D6A64399A.title": "Insanium",
  "quest.0FE132183A9E2A3E.quest_desc": [
    "Store everything in an ME network, then automate crafting. See &eApplied Energistics 2&r.",
  ],
  "quest.0FE132183A9E2A3E.title": "Digital Storage",
  "quest.1301F1BA2A9F98D4.quest_desc": [
    "All 19 singularities and a Creative Singularity, in the Ultimate Crafting Table. See &eEndgame: Infinity&r.",
  ],
  "quest.1301F1BA2A9F98D4.title": "The Ultimate Singularity",
  "quest.143A85C42BF5A10D.quest_desc": [
    "The rarest metal, from the End Highlands. See &eAllthemodium&r.",
  ],
  "quest.143A85C42BF5A10D.title": "Unobtainium",
  "quest.16E8BC56D17D7680.quest_desc": [
    "All roads meet here. The Elite Crafting Table needs materials from every road. See &eEndgame: Infinity&r.",
  ],
  "quest.16E8BC56D17D7680.title": "Extended Crafting",
  "quest.1D8895A769D06F38.quest_desc": [
    "Mine Allthemodium in the Mining Dimension. See &eAllthemodium&r.",
  ],
  "quest.1D8895A769D06F38.title": "Allthemodium",
  "quest.3691393C3E98B5A3.quest_desc": [
    "Better enchanting, gems and affix loot. See &eApotheosis&r.",
  ],
  "quest.3691393C3E98B5A3.title": "Gems \\& Affixes",
  "quest.39E731A91263BD52.quest_desc": [
    "Grow resources with Mystical Agriculture. See &eMystical Agriculture&r and the &eSeed Codex&r.",
  ],
  "quest.39E731A91263BD52.title": "Magical Farming",
  "quest.3CB23CE64EFDD940.quest_desc": [
    "This chapter is a &emap of GSPack&r. Each quest is a milestone from another chapter, and the lines show the order to reach them.",
    "",
    "There are three roads, &9Technology&r, &aMagic&r and &6Exploration&r, and they all lead to the &dTrophy of Infinity&r. You do not have to finish one road before starting another: most players go back and forth.",
    "",
    "The milestones complete on their own when you have the item. Open the chapter named in each quest for the details.",
  ],
  "quest.3CB23CE64EFDD940.title": "The Road Ahead",
  "quest.45340A1E8EC870FB.quest_desc": [
    "The Supercritical Phase Shifter makes Antimatter, used in many endgame recipes. See &eMekanism&r.",
  ],
  "quest.45340A1E8EC870FB.title": "Antimatter",
  "quest.4A19ACFF6659EA44.quest_desc": [
    "Oritech's machines and addons. See &eOritech&r.",
  ],
  "quest.4A19ACFF6659EA44.title": "Animated Machines",
  "quest.4E77C0883E27C158.quest_desc": [
    "Dark Matter needs Vibranium, Red Matter needs Unobtainium. See &eEquivox&r.",
  ],
  "quest.4E77C0883E27C158.title": "Red Matter",
  "quest.54102498A4AE1D14.quest_desc": [
    "Research aspects, vis and infusion. See &eThaumaturge&r.",
  ],
  "quest.54102498A4AE1D14.title": "The Arcane",
  "quest.5DE21E16F099588A.quest_desc": [
    "Light a Nether portal and step through. See &eGetting Started&r.",
  ],
  "quest.5DE21E16F099588A.title": "Into the Nether",
  "quest.5EA6B455B82F34F0.quest_desc": [
    "The end goal of GSPack. See &eEndgame: Infinity&r, and the &eTrophy Checklist&r for every ingredient.",
