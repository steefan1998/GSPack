{
  "chapter.51E24E671CE7E30E.chapter_subtitle": [
    "Digital storage, channels and automated crafting.",
  ],
  "chapter.51E24E671CE7E30E.title": "Applied Energistics 2",
  "quest.014820B6FA99E2F3.quest_desc": [
    "Used for sky stone chests and tanks, and in the Charger. Smooth sky stone looks great too.",
  ],
  "quest.014820B6FA99E2F3.title": "Sky Stone",
  "quest.05A17155B2CC1C4E.quest_desc": [
    "Move Mekanism chemicals through your ME cables.",
  ],
  "quest.05A17155B2CC1C4E.title": "Chemical P2P",
  "quest.0648539C34551F43.quest_desc": [
    "Used to make name presses and to cut quartz.",
  ],
  "quest.0648539C34551F43.title": "Cutting Knife",
  "quest.0AAC6691D69FD904.quest_desc": [
    "Smart cables show how many channels they use. Great for debugging.",
  ],
  "quest.0AAC6691D69FD904.title": "Smart Cables",
  "quest.0ADA6540DB1C6940.quest_desc": [
    "Holds patterns and pushes ingredients into the machine next to it. The machine's output must go back into the network (an interface or import bus).",
  ],
  "quest.0ADA6540DB1C6940.title": "Pattern Provider",
  "quest.0EB9335F990424F0.quest_desc": [
    "Carry 32 channels. Use them as the backbone of a large network.",
  ],
  "quest.0EB9335F990424F0.title": "Dense Cables",
  "quest.10E72CB88803CEC5.quest_desc": [
    "&bAE2 Wireless Terminals&r adds more terminals and an upgrade for infinite range with a Quantum Bridge singularity.",
  ],
  "quest.10E72CB88803CEC5.title": "Wireless Crafting Terminal",
  "quest.118AEEE8F1FFC56B.quest_desc": [
    "Annihilation planes break blocks in front of them, formation planes place them. Perfect for a cobblestone or quartz farm.",
  ],
  "quest.118AEEE8F1FFC56B.title": "Formation \\& Annihilation",
  "quest.15A116E0BCDA8A4C.quest_desc": [
    "A P2P tunnel sends something through a single channel: &eME channels&r (32 at once through one!), items, fluids, energy, redstone or light.",
    "",
    "Link the two ends with a &eMemory Card&r (shift-click the input, then click the output).",
  ],
  "quest.15A116E0BCDA8A4C.title": "P2P Tunnels",
  "quest.16356B8188D0413D.quest_desc": [
    "Put an &eInfinity Card&r in a Wireless Access Point and your wireless terminals work at any distance in that dimension.",
    "",
    "The &eDimension Card&r goes one step further and works across dimensions.",
  ],
  "quest.16356B8188D0413D.title": "Infinity Booster",
  "quest.16545F6399D951C1.quest_desc": [
    "Gives wireless coverage around it. Wireless Boosters increase the range.",
  ],
  "quest.16545F6399D951C1.title": "Wireless Access Point",
  "quest.1921A0024EF4410C.quest_desc": [
    "&bReplication&r copies items out of &ematter&r.",
    "",
    "Find &eReplica ore&r deep underground and smelt it into Replica ingots. They are used to build the machines.",
  ],
  "quest.1921A0024EF4410C.title": "Replication",
  "quest.197EBAF6B72273C2.quest_desc": [
    "A crafting CPU is a solid cuboid multiblock of crafting units, at least one crafting storage, and optionally co-processors (accelerators) and a monitor.",
    "",
    "Storage sets how big a job can be. Accelerators make it faster.",
  ],
  "quest.197EBAF6B72273C2.title": "Crafting CPU",
  "quest.1B3FF85646387335.quest_desc": [
    "- &eSpeed Card&r: faster buses.",
    "- &eCapacity Card&r: more filter slots.",
    "- &eFuzzy Card&r: match damaged tools or ignore components.",
    "- &eRedstone Card&r: control with redstone.",
    "- &eCrafting Card&r: let buses request crafts.",
  ],
  "quest.1B3FF85646387335.title": "Upgrade Cards",
  "quest.1BE6AE82C2C63DE2.quest_desc": [
    "&bPolymorphic AE2&r makes autocrafting smarter when several recipes share the same ingredients. It works in the background.",
  ],
  "quest.1BE6AE82C2C63DE2.title": "Polymorphic AE2",
  "quest.1C47D1636E5D8ADC.quest_desc": [
    "How it works:",
    "1. The &eIdentification Chamber&r scans an item and saves it on a &eMemory Chip&r.",
    "2. The &eDisintegrator&r breaks items down into matter.",
    "3. The &eReplicator&r uses that matter to build copies of scanned items.",
    "",
    "Connect them with Matter Network Pipes.",
  ],
  "quest.1C47D1636E5D8ADC.title": "The Replicator",
  "quest.1CAD1025C508E89A.quest_desc": [
    "The &eAssembler Matrix&r is a multiblock that runs a huge number of crafting patterns at the same time. It replaces walls of Molecular Assemblers.",
    "",
    "Check JEI for the parts and how to build it.",
  ],
  "quest.1CAD1025C508E89A.title": "Assembler Matrix",
  "quest.1FB3941ADA6BB034.quest_desc": [
    "Put crafting patterns in a &ePattern Provider&r next to &eMolecular Assemblers&r and AE2 crafts anything for you.",
    "",
    "Request a craft in the terminal with &eright-click&r (or middle-click) on an item. Welcome to autocrafting!",
  ],
  "quest.1FB3941ADA6BB034.title": "Molecular Assembler",
  "quest.22794BCF72C37648.quest_desc": [
    "Ender disks share their contents by frequency, so two networks (even in other dimensions) can use the same storage.",
  ],
  "quest.22794BCF72C37648.title": "Ender Drives",
  "quest.22834634E9E10048.quest_desc": [
    "The extended interface and drive hold much more than the normal ones. Great for big networks.",
  ],
  "quest.22834634E9E10048.title": "Extended Devices",
  "quest.273A6F1933B91CAD.quest_desc": [
    "Quickly empty or fill storage cells. Great for moving to bigger cells.",
  ],
  "quest.273A6F1933B91CAD.title": "ME IO Port",
  "quest.283E9173C8848993.quest_desc": [
    "Two quantum rings with a pair of entangled singularities connect networks across any distance, even across dimensions.",
  ],
  "quest.283E9173C8848993.title": "Quantum Bridge",
  "quest.285B84FAED473B5A.quest_desc": [
    "&bApplied Mekanistics&r lets your ME network store Mekanism &echemicals&r: gases, infuse types, pigments and slurries. Pattern providers can also push chemicals into Mekanism machines.",
  ],
  "quest.285B84FAED473B5A.title": "Chemical Storage",
  "quest.29A73A59ECB9B5A6.quest_desc": [
    "Quantum computer storage blocks hold enormous crafting jobs.",
  ],
  "quest.29A73A59ECB9B5A6.title": "Quantum Storage",
  "quest.2A2390FE4DD4843F.quest_desc": [
    "A cell has a number of &ebytes&r and holds up to &e63 types&r of items.",
    "",
    "Each new type costs some bytes, so a few types in big amounts are stored most efficiently.",
  ],
  "quest.2A2390FE4DD4843F.title": "First Storage Cell",
  "quest.2D3ABE72931F1F61.quest_desc": [
    "Printed circuit + printed silicon + redstone = processor. You will need many of each, so think about automating this early!",
  ],
  "quest.2D3ABE72931F1F61.title": "Processors",
  "quest.2DBA7B405F9F9DCF.quest_desc": [
    "Place it next to budding quartz and power it. Crystals grow many times faster. Combine with an annihilation plane to harvest automatically.",
  ],
  "quest.2DBA7B405F9F9DCF.title": "Growth Accelerator",
  "quest.30BE516549FA0D54.quest_desc": [
    "A single-cell storage block with a built-in terminal.",
  ],
  "quest.30BE516549FA0D54.title": "ME Chest",
  "quest.31F4F93DF2BD5A8B.quest_desc": [
    "Store a whole area of the world in a cell and put it back somewhere else. You can even move your base!",
  ],
  "quest.31F4F93DF2BD5A8B.title": "Spatial Storage",
  "quest.32348528C0CF1C3B.quest_desc": [
    "Charged certus is needed for fluix crystals.",
  ],
  "quest.32348528C0CF1C3B.title": "Charged Certus",
  "quest.32C08C873EFF4D8A.quest_desc": [
    "The Inscriber presses circuits. Put the press in the top slot, the material in the middle, and (for processors) the second press in the bottom slot.",
    "",
    "&6Tip:&r With automation, use separate inscribers for each step.",
  ],
  "quest.32C08C873EFF4D8A.title": "Inscriber",
  "quest.35F821B5CF20B34C.quest_desc": [
    "Points to the nearest meteorite. Handy if you are having trouble finding one.",
  ],
  "quest.35F821B5CF20B34C.title": "Meteorite Compass",
  "quest.3A618E03A0055D60.quest_desc": [
    "Connects Replication to your ME network and stores matter in ME cells.",
  ],
  "quest.3A618E03A0055D60.title": "Applied Replicatics",
  "quest.3AEE430308F06724.quest_desc": [
    "Two Wireless Connectors link parts of a network without cables. Pair them with the Wireless Setup Kit.",
  ],
  "quest.3AEE430308F06724.title": "Wireless Connector",
  "quest.3BB984342977089F.quest_desc": [
    "Fluix tools are a bit faster than iron.",
  ],
  "quest.3BB984342977089F.title": "Fluix Tools",
  "quest.3BCEABAC45095316.quest_desc": [
    "A crystal used in many ExtendedAE recipes. JEI shows how to grow and harvest it.",
  ],
  "quest.3BCEABAC45095316.title": "Entro Crystals",
  "quest.3DCB426C2D3D35BD.quest_desc": [
    "&bAdvanced AE&r adds quantum tech: much faster crafting, huge storage and the Quantum Armor.",
    "",
    "Quantum Alloy and the other materials are made in the &eReaction Chamber&r.",
  ],
  "quest.3DCB426C2D3D35BD.title": "Advanced AE",
  "quest.3DCF583935A1592C.quest_desc": [
    "&bExtendedAE&r adds extended versions of the AE2 devices you already know, with more slots and more features:",
    "- &eExtended Pattern Provider&r: many more pattern slots.",
    "- &eExtended Interface&r, &eExtended Drive&r and &eExtended I/O Port&r.",
    "- New buses and emitters: tag, threshold, precise and mod filters.",
    "",
    "Press U on any AE2 device in JEI to see its extended version.",
  ],
  "quest.3DCF583935A1592C.quest_subtitle": "Bigger and better ME devices",
  "quest.3DCF583935A1592C.title": "ExtendedAE",
  "quest.3E19DD13B4769306.quest_desc": [
    "Rotate and pick up AE2 blocks and parts.",
  ],
  "quest.3E19DD13B4769306.title": "Certus Wrench",
  "quest.3FCDEDC469AB4497.quest_desc": [
    "A small storage cell you carry with you.",
  ],
  "quest.3FCDEDC469AB4497.title": "Portable Cell",
  "quest.4108F5E7AE39F44D.quest_desc": [
    "Each size holds four times as much. Combine the cell component with an item cell housing.",
  ],
  "quest.4108F5E7AE39F44D.title": "Bigger Cells",
  "quest.440E7BC045315C69.quest_desc": [
    "Big jobs need big CPUs. Build several CPUs to run crafts in parallel.",
  ],
  "quest.440E7BC045315C69.title": "Bigger CPUs",
  "quest.4421EF16E6AD3337.quest_desc": [
    "A huge crafting CPU multiblock that can run many crafting jobs at once, with multi-threading.",
  ],
  "quest.4421EF16E6AD3337.title": "Quantum Computer",
  "quest.45A49363645D4CCE.quest_desc": [
    "&bApplied Thaumaturge&r stores &dessentia&r in your ME network, in essentia cells, and lets you see it in the Essentia Terminal.",
    "",
    "It also adds arcane crafting and infusion helpers for automation. Check JEI!",
  ],
  "quest.45A49363645D4CCE.title": "Applied Thaumaturge",
  "quest.4723C67B1AA17F16.quest_desc": [
    "&bME Requester&r keeps a set amount of items crafted at all times. Never run out of processors again!",
  ],
  "quest.4723C67B1AA17F16.title": "ME Requester",
  "quest.4A4F893F16E66A2D.quest_desc": [
    "Budding certus quartz grows crystals on its sides, just like amethyst.",
    "",
    "The budding block slowly decays: flawless -> flawed -> chipped -> damaged. Only flawless budding quartz never decays, and it cannot be moved.",
  ],
  "quest.4A4F893F16E66A2D.title": "Budding Quartz",
  "quest.4B50BCB44EDF65B6.quest_desc": [
    "Link it in the Access Point's slot, and access your network anywhere in range.",
  ],
  "quest.4B50BCB44EDF65B6.title": "Wireless Terminal",
  "quest.4E549DE8B37D0AB8.quest_desc": [
    "Partition a cell so it only accepts certain items, and add upgrade cards.",
  ],
  "quest.4E549DE8B37D0AB8.title": "Cell Workbench",
  "quest.4EF8C3753D6C3D54.quest_desc": [
    "See and take every item in your network. Use the search bar, and sort by name, amount or mod.",
  ],
  "quest.4EF8C3753D6C3D54.title": "ME Terminal",
  "quest.504F1061E850B2FF.quest_desc": [
    "&bApplied Flux&r stores &eFE energy&r in your ME network, in FE storage cells inside an ME Drive.",
    "",
    "The &eFlux Accessor&r lets machines take energy from the network and put it back. One network can now hold both your items and your power.",
  ],
  "quest.504F1061E850B2FF.title": "Applied Flux",
  "quest.55B0F0678EF0E6EC.quest_desc": [
    "&bApplied Oritech&r adds ME addons for Oritech machines. Attach them to an Oritech machine to connect it straight to your network.",
  ],
  "quest.55B0F0678EF0E6EC.title": "Applied Oritech",
  "quest.598913DCAF3E262F.quest_desc": [
    "Armor powered by your ME network, with upgrade cards for flight, speed, step assist, magnet, regeneration and much more.",
    "",
    "Install the cards in the Quantum Armor workbench menu.",
  ],
  "quest.598913DCAF3E262F.title": "Quantum Armor",
  "quest.59FE974BB8E9A846.quest_desc": [
    "Store power for the network so it keeps running when the generators stop.",
  ],
  "quest.59FE974BB8E9A846.title": "Energy Cells",
  "quest.5DFF7365FFAC7652.quest_desc": [
    "Find a meteorite. They are big craters full of &eSky Stone&r.",
    "",
    "In the middle is a &eMysterious Cube&r with one of the four inscriber presses. Bring a pickaxe, sky stone is very hard!",
  ],
  "quest.5DFF7365FFAC7652.title": "Fallen Star",
  "quest.5E04DAC5C4D91017.quest_desc": [
    "The biggest AE2 storage cell.",
  ],
  "quest.5E04DAC5C4D91017.title": "256k Storage",
  "quest.5E5A4D6E3384BBBC.quest_desc": [
    "Manage the patterns in every provider on the network from one screen.",
  ],
  "quest.5E5A4D6E3384BBBC.title": "Pattern Access Terminal",
  "quest.5F83D571EF6D998E.quest_desc": [
    "Gold makes logic circuits, certus makes calculation circuits, and diamond makes engineering circuits.",
  ],
  "quest.5F83D571EF6D998E.title": "Printed Circuits",
  "quest.6081472C7E729951.quest_desc": [
    "Throw charged certus quartz, redstone and nether quartz into a pool of water. A moment later they turn into &eFluix Crystals&r.",
    "",
    "Fluix is used in cables, the controller and many components.",
  ],
  "quest.6081472C7E729951.title": "Fluix Crystals",
  "quest.61513660EAAB7025.quest_desc": [
    "Encode recipes into patterns. There are two kinds:",
    "- &eCrafting&r patterns, for crafting table recipes.",
    "- &eProcessing&r patterns, for machines (furnace, Mekanism, Oritech, ...).",
    "",
    "Use JEI's + button in the encoding terminal to fill in a recipe.",
  ],
  "quest.61513660EAAB7025.title": "Patterns",
  "quest.61C7B199AAAA6D35.quest_desc": [
    "Glass cables carry &e8 channels&r. Later, &eDense Cables&r carry 32.",
    "",
    "&6Tip:&r Colour cables with dye to stop them connecting to each other.",
  ],
  "quest.61C7B199AAAA6D35.title": "Cables",
  "quest.6484448D54D8BEF5.quest_desc": [
    "Holds up to 10 storage cells.",
  ],
  "quest.6484448D54D8BEF5.title": "ME Drive",
  "quest.680F8C34195B4A90.quest_desc": [
    "Smelt certus or nether quartz dust into silicon, then press it with the silicon press.",
  ],
  "quest.680F8C34195B4A90.title": "Silicon",
  "quest.69438C5C547C8877.quest_desc": [
    "Sends each ingredient of a pattern to a specific side of a machine. Great for machines with several inputs.",
  ],
  "quest.69438C5C547C8877.title": "Advanced Pattern Provider",
  "quest.6DE98D174383418D.quest_desc": [
    "AE2 can store fluids too. Use buckets in the terminal, or pipes into an interface.",
  ],
  "quest.6DE98D174383418D.title": "Fluid Storage",
  "quest.712ACDB93B851213.quest_desc": [
    "The heart of the network. Each face of a controller provides &e32 channels&r.",
    "",
    "Without a controller, a network can still run with 8 devices (ad-hoc mode). With one, it can grow very large. Controllers can be built as multiblocks up to 7x7x7.",
    "",
    "Power it with an &eEnergy Acceptor&r connected to any FE source.",
  ],
  "quest.712ACDB93B851213.title": "ME Controller",
  "quest.714E2728654BF641.quest_desc": [
    "Keeps chosen items in stock and lets machines and pipes talk to the network.",
  ],
  "quest.714E2728654BF641.title": "ME Interface",
  "quest.732B0B16A71B5086.quest_desc": [
    "Charge certus quartz into &eCharged Certus Quartz&r. Power it with FE, or put a &eCrank&r on top and turn it by hand.",
  ],
  "quest.732B0B16A71B5086.title": "Charger",
  "quest.74755E618C84970D.quest_desc": [
    "Every device on the network (terminals, buses, interfaces...) uses one &echannel&r.",
    "- Glass/covered/smart cable: 8 channels.",
    "- Dense cable: 32 channels.",
    "- Controller face: 32 channels.",
    "",
    "Plan your network as a tree: dense cables from the controller, normal cables to the devices.",
  ],
  "quest.74755E618C84970D.title": "Channels",
  "quest.74B13E780100F604.quest_desc": [
    "Pushes chosen items out of the network into an inventory.",
  ],
  "quest.74B13E780100F604.title": "Export Bus",
  "quest.75129AE84F82D6DD.quest_desc": [
    "Pulls items from an inventory into the network.",
  ],
  "quest.75129AE84F82D6DD.title": "Import Bus",
  "quest.767A29DA9EF5203D.quest_desc": [
    "Right-click an ME P2P tunnel with an item to change its type (for example a cable for FE, a chest for items).",
  ],
  "quest.767A29DA9EF5203D.title": "P2P Variety",
  "quest.77C8DB5AC6C4C1EF.quest_desc": [
    "&bApplied Energistics 2&r turns items into data. Instead of chests full of stuff, you get one network that holds everything and can craft for you.",
    "",
    "Find &eCertus Quartz&r in &emeteorites&r (craters of sky stone) and in quartz geodes underground.",
    "",
    "&6Tip:&r Read the in-game guide! Hold &eG&r while hovering over any AE2 item to open its page.",
  ],
  "quest.77C8DB5AC6C4C1EF.quest_subtitle": "The crystal that powers the network",
  "quest.77C8DB5AC6C4C1EF.title": "Certus Quartz",
  "quest.78AB24FA8C4E547D.quest_desc": [
    "A fast processing machine for Advanced AE materials. It needs power, fluids and items.",
  ],
  "quest.78AB24FA8C4E547D.title": "Reaction Chamber",
  "quest.78CE003A3EB19363.quest_desc": [
    "Each meteorite holds one press. Collect all four: &eCalculation&r, &eEngineering&r, &eLogic&r and &eSilicon&r.",
    "",
    "Once you have one, the Inscriber can make copies from an iron block, so you only need to find each press once.",
  ],
  "quest.78CE003A3EB19363.title": "The Four Presses",
  "quest.7D81EFDA3E495534.quest_desc": [
    "Makes any chest, barrel or drawer part of the network. Also works on Mekanism bins and Sophisticated Storage.",
  ],
  "quest.7D81EFDA3E495534.title": "Storage Bus",
  "quest.7E0DE3E91C9C70EC.quest_desc": [
    "A terminal with a crafting grid that pulls ingredients straight from storage. JEI's + button fills it for you.",
  ],
  "quest.7E0DE3E91C9C70EC.title": "Crafting Terminal",
  "quest.7E14754EAEEB3F16.quest_desc": [
    "Gives a redstone signal when an item goes above or below a set amount. Great for \"keep 1000 iron in stock\" setups.",
  ],
  "quest.7E14754EAEEB3F16.title": "Level Emitter",
}
