{
  "chapter.329774BD106DA4BD.chapter_subtitle": [
    "Build a space program: fuel, space suits, rockets and the Moon."
  ],
  "chapter.329774BD106DA4BD.title": "Stellaris",
  "quest.00F4BF3A1192C1F4.quest_desc": [
    "More oxygen for your suit. Higher tiers last much longer."
  ],
  "quest.00F4BF3A1192C1F4.title": "Oxygen Module",
  "quest.0181AEDC15558730.quest_desc": [
    "Rocket parts, suits and modules are built here. Check JEI for the recipes."
  ],
  "quest.0181AEDC15558730.title": "Engineering Station",
  "quest.01B841FBB8258813.quest_desc": [
    "Claim the Moon for your team!"
  ],
  "quest.01B841FBB8258813.title": "Plant a Flag",
  "quest.07F24D407443E2E4.quest_desc": [
    "Pumps oil from an underground deposit."
  ],
  "quest.07F24D407443E2E4.title": "Pumpjack",
  "quest.0D02620463F1C457.quest_desc": [
    "Stores energy for when you need it."
  ],
  "quest.0D02620463F1C457.title": "Power Bank",
  "quest.0D42D259F83FC1EA.quest_desc": [
    "Find a five-dome settlement in Martian Colony Flats. Spaceman villagers sell local building materials and expedition supplies. Protected life-support installations replenish native oxygen and energy; keep the airlock closed. Villagers are independently immune to oxygen loss."
  ],
  "quest.0D42D259F83FC1EA.title": "The Oxygen Colonies",
  "quest.0DAEAAC27143426C.quest_desc": [
    "Automatically unloads rockets."
  ],
  "quest.0DAEAAC27143426C.title": "Cargo Unloader",
  "quest.0E305B1C7F6DFAE5.quest_desc": [
    "Find a large novite formation."
  ],
  "quest.0E305B1C7F6DFAE5.title": "Novite Deposit",
  "quest.11CD65DB0BF03FA0.quest_desc": [
    "Lets your rocket fly without you."
  ],
  "quest.11CD65DB0BF03FA0.title": "Autopilot",
  "quest.133998F715FC0608.quest_desc": [
    "Build a shelter and a supported oxygen setup, store return fuel and mark the landing area in JourneyMap. Tick after testing the outpost and oxygen coverage."
  ],
  "quest.133998F715FC0608.title": "A Martian Outpost",
  "quest.1349CC872709D047.quest_desc": [
    "Somebody was here before you."
  ],
  "quest.1349CC872709D047.title": "First Landing Site",
  "quest.13F5E3AE02259E27.quest_desc": [
    "Plating blocks make your launch site look the part."
  ],
  "quest.13F5E3AE02259E27.title": "Space Age Building",
  "quest.16B426C3A54E7A85.quest_desc": [
    "Splits water into hydrogen and oxygen."
  ],
  "quest.16B426C3A54E7A85.title": "Electrolyzer",
  "quest.177039C67A583CA5.quest_desc": [
    "Select Mars using Stellaris planet selection and travel with your rocket. GSPack adds this dry world with 3.71 gravity and no breathable oxygen. A Mars sol lasts 24,660 game ticks (20 minutes 33 seconds at 20 TPS), scaled from NASA Mars24. Bring a working space suit, oxygen, fuel, food and a plan for the return flight."
  ],
  "quest.177039C67A583CA5.title": "The Red Planet",
  "quest.17829AB701ACED54.quest_desc": [
    "Build a 3x3 launch pad."
  ],
  "quest.17829AB701ACED54.title": "Launch Pad",
  "quest.180FE6C3A7BC6189.quest_desc": [
    "Build your own space station in orbit."
  ],
  "quest.180FE6C3A7BC6189.title": "Space Station",
  "quest.1965210124E7536F.quest_desc": [
    "Return safely to Earth with Martian samples. Mars is an exploration extension; it is not a new prerequisite for building your first Moon rocket."
  ],
  "quest.1965210124E7536F.title": "There and Back Again",
  "quest.19CD505C1CF67B23.quest_desc": [
    "Strange glowing crystals."
  ],
  "quest.19CD505C1CF67B23.title": "Astrum Crystals",
  "quest.1BDF29069D360970.quest_desc": [
    "&bStellaris&r takes you into space and to the Moon.",
    "",
    "Start by finding &eTitanium ore&r underground (also in deepslate). Titanium is the core material of your space program."
  ],
  "quest.1BDF29069D360970.quest_subtitle": "The space program begins",
  "quest.1BDF29069D360970.title": "Titanium",
  "quest.1D12D87020CCCF49.quest_desc": [
    "Build your rocket and place it on the launch pad. Fill it with &erocket fuel&r.",
    "",
    "Get in, put on your space suit, and launch!"
  ],
  "quest.1D12D87020CCCF49.title": "Rocket",
  "quest.1E5D4B01229D6803.quest_desc": [
    "Visit the other lunar biomes."
  ],
  "quest.1E5D4B01229D6803.title": "Lunar Explorer",
  "quest.1FAEBDDF4CC7750D.quest_desc": [
    "Oil is hidden underground. The Oil Finder tells you where."
  ],
  "quest.1FAEBDDF4CC7750D.title": "Find Oil",
  "quest.210059A2E58C2D1D.quest_desc": [
    "A handheld computer for your space program."
  ],
  "quest.210059A2E58C2D1D.title": "Tablet",
  "quest.21DA6E7D119F2ACA.quest_desc": [
    "Launch and reach &eEarth Orbit&r. Look at the view!"
  ],
  "quest.21DA6E7D119F2ACA.title": "To Orbit!",
  "quest.23C244273831DE41.quest_desc": [
    "A cleaner way to power your machines."
  ],
  "quest.23C244273831DE41.title": "Hydrogen Motor",
  "quest.23FFF81DE7891C73.quest_desc": [
    "Defeat the boss hiding in the heart of the Moon and claim its trophy."
  ],
  "quest.23FFF81DE7891C73.title": "Heart of Luna",
  "quest.25565B43806CD538.quest_desc": [
    "Alien pillagers occupy camps in the ordinary wastes and Colony Flats. Their captains use the native ominous-bottle and raid progression. Only pillagers join raids on Mars; they retain native raid bookkeeping and use the Mars alien skin. Other dimensions are unaffected."
  ],
  "quest.25565B43806CD538.title": "Martian Raiders",
  "quest.25E74C0D1B65791E.quest_desc": [
    "A satellite fell to Earth. Search the wreck!"
  ],
  "quest.25E74C0D1B65791E.title": "Crashed Satellite",
  "quest.2606AFA8ABD5A542.quest_desc": [
    "Research and process strange materials."
  ],
  "quest.2606AFA8ABD5A542.title": "Laboratory",
  "quest.26290EB27A3E93F5.quest_desc": [
    "Fly around in low gravity with your space suit."
  ],
  "quest.26290EB27A3E93F5.title": "Jet Module",
  "quest.2943F706F963735F.quest_desc": [
    "Find the cold climate regions of Mars. Packed Ice covers Blue Ice deposits; oxygen is still required."
  ],
  "quest.2943F706F963735F.title": "Frozen Wastes",
  "quest.2A2C57D0C1DF60C2.quest_desc": [
    "The parts every rocket needs. &6GSPack:&r the Rocket Engine needs an Oritech &eProcessing Unit&r."
  ],
  "quest.2A2C57D0C1DF60C2.title": "Rocket Parts",
  "quest.2B6865F28F279B94.quest_desc": [
    "The final challenge of Stellaris. You are a true astronaut!"
  ],
  "quest.2B6865F28F279B94.title": "Star Crawler Queen",
  "quest.2BBAD23B589EC925.quest_desc": [
    "Spreads oxygen further through a large base."
  ],
  "quest.2BBAD23B589EC925.title": "Oxygen Propagator",
  "quest.2D33EFC79CB1CB71.quest_desc": [
    "Take some souvenirs home."
  ],
  "quest.2D33EFC79CB1CB71.title": "Moon Rocks",
  "quest.2DD3E437DC776B9B.quest_desc": [
    "Power for your machines. Connect everything with cables."
  ],
  "quest.2DD3E437DC776B9B.title": "Coal Generator",
  "quest.2F9011F973FDF160.quest_desc": [
    "The Moon's inhabitants are not always friendly."
  ],
  "quest.2F9011F973FDF160.title": "Aliens",
  "quest.3236149471DDCD4D.quest_desc": [
    "Change the gravity around you."
  ],
  "quest.3236149471DDCD4D.title": "Gravity Manipulator",
  "quest.3251FA43CECC1596.quest_desc": [
    "The Moon has its own versions of familiar ores."
  ],
  "quest.3251FA43CECC1596.title": "Lunar Ores",
  "quest.35BD67960377F8F8.quest_desc": [
    "Find an abandoned operation base. It may still hold useful supplies."
  ],
  "quest.35BD67960377F8F8.title": "Earth Operation Base",
  "quest.36999C7AEC925B41.quest_desc": [
    "Collect the red surface materials. Mars has no surface oceans or natural food supply; prepare on Earth before travelling."
  ],
  "quest.36999C7AEC925B41.title": "Martian Geology",
  "quest.3BA0116BABDF1B21.quest_desc": [
    "Free power during the day."
  ],
  "quest.3BA0116BABDF1B21.title": "Solar Panel",
  "quest.3E27835E2D0E4509.quest_desc": [
    "Yes, there are trees on this Moon."
  ],
  "quest.3E27835E2D0E4509.title": "Lunar Forest",
  "quest.3E4A01927D362A47.quest_desc": [
    "Protects your rocket."
  ],
  "quest.3E4A01927D362A47.title": "Shield Module",
  "quest.3EECBC9EE8066B40.quest_desc": [
    "Explore the dome and defeat its spawners. Its damaged airlock no longer provides breathable air: bring your own oxygen. Three loot chests include one guaranteed Martian Research Relic."
  ],
  "quest.3EECBC9EE8066B40.title": "The Abandoned Oxygen Dome",
  "quest.4191D2B7160DA683.quest_desc": [
    "Burns diesel for much more power."
  ],
  "quest.4191D2B7160DA683.title": "Diesel Generator",
  "quest.427C1A60C7FE7F75.quest_desc": [
    "An uncommon Martian biome where abandoned research domes may generate. Search new terrain; domes are not found in the ordinary or frozen wastes."
  ],
  "quest.427C1A60C7FE7F75.title": "Research Wastes",
  "quest.42CD8A79F3115255.quest_desc": [
    "Tier 2 oxygen."
  ],
  "quest.42CD8A79F3115255.title": "Better Oxygen",
  "quest.4715578D7CD0F850.quest_desc": [
    "Combine the dungeon relic with lunar Novite, Nitro Crystals, Quantum Processors and an Extended Crafting frame in the Advanced Table (5x5). The Martian Navigation Core is an ingredient of the Cosmic Core. These items have no EMC."
  ],
  "quest.4715578D7CD0F850.title": "Martian Research",
  "quest.491C8E9F488F32DC.quest_desc": [
    "Something attacked this village."
  ],
  "quest.491C8E9F488F32DC.title": "Ruined Moon Village",
  "quest.4A0FBF7C10277436.quest_desc": [
    "A ship crashed here. Search the wreck."
  ],
  "quest.4A0FBF7C10277436.title": "Wrecked Spaceship",
  "quest.4BB1BD5CE3B19DCD.quest_desc": [
    "A dungeon deep in the Moon. Something big is waiting there."
  ],
  "quest.4BB1BD5CE3B19DCD.title": "Moon Dungeon",
  "quest.4EA4DE9ED5CB8B3C.quest_desc": [
    "Used in electronics."
  ],
  "quest.4EA4DE9ED5CB8B3C.title": "Silicon",
  "quest.525A038423C3EE03.quest_desc": [
    "Extra storage in your rocket."
  ],
  "quest.525A038423C3EE03.title": "Cargo Module",
  "quest.560BB0DC5C790D4D.quest_desc": [
    "An abandoned outpost on the Moon."
  ],
  "quest.560BB0DC5C790D4D.title": "Lunar Outpost",
  "quest.5745268E4C4534CE.quest_desc": [
    "People... on the Moon?"
  ],
  "quest.5745268E4C4534CE.title": "Moon Village",
  "quest.57DFD35E721C0E91.quest_desc": [
    "A large base, long abandoned."
  ],
  "quest.57DFD35E721C0E91.title": "Moon Space Base",
  "quest.5803AD73047EDB73.quest_desc": [
    "Drive across the Moon in style."
  ],
  "quest.5803AD73047EDB73.title": "Rover",
  "quest.58BC606038F1BE46.quest_desc": [
    "Give your rocket a new look."
  ],
  "quest.58BC606038F1BE46.title": "Rocket Skins",
  "quest.58C854681A0038DE.quest_desc": [
    "There is no air in space! A full space suit keeps you alive outside.",
    "",
    "Fill it with &eoxygen&r before you go, and keep an eye on the oxygen bar."
  ],
  "quest.58C854681A0038DE.title": "Space Suit",
  "quest.591A6D20BB4793EF.quest_desc": [
    "Refines oil into &erocket fuel&r. You will need a lot for each launch."
  ],
  "quest.591A6D20BB4793EF.title": "Fuel Refinery",
  "quest.5A1797C5D659294C.quest_desc": [
    "Crawling creatures from the depths."
  ],
  "quest.5A1797C5D659294C.title": "Star Crawlers",
  "quest.5AE05E82C35B346C.quest_desc": [
    "Land on the &7Moon&r!",
    "",
    "The gravity is low, there is no air, and things live here. Watch your oxygen at all times."
  ],
  "quest.5AE05E82C35B346C.title": "One Small Step",
  "quest.5CE8C38DCBE28283.quest_desc": [
    "See in the dark of space."
  ],
  "quest.5CE8C38DCBE28283.title": "Night Vision",
  "quest.5E9E0CBA212F37E5.quest_desc": [
    "Make your rover faster and give it a bigger tank."
  ],
  "quest.5E9E0CBA212F37E5.title": "Rover Upgrades",
  "quest.616549397B333FCA.quest_desc": [
    "Lunar food. Careful what you eat up here."
  ],
  "quest.616549397B333FCA.title": "Moon Berries",
  "quest.63CD415CA2922E06.quest_desc": [
    "Makes your suit tougher."
  ],
  "quest.63CD415CA2922E06.title": "Damage Protection",
  "quest.645034E2A05EE4BA.quest_desc": [
    "Fills a sealed room with air, so you can take your helmet off inside your base."
  ],
  "quest.645034E2A05EE4BA.title": "Oxygen Distributor",
  "quest.650AF81D1B5BE887.quest_desc": [
    "Strange purple-tinted wood."
  ],
  "quest.650AF81D1B5BE887.title": "Lunar Wood",
  "quest.68D65FD80F193B1B.quest_desc": [
    "A rare and powerful metal."
  ],
  "quest.68D65FD80F193B1B.title": "Novite",
  "quest.6950852F37D9C4FE.quest_desc": [
    "Cures and protects you from parasite infection."
  ],
  "quest.6950852F37D9C4FE.title": "Vaccine",
  "quest.69DC8181409DA62D.quest_desc": [
    "Move and store fuel, oil, water and gases."
  ],
  "quest.69DC8181409DA62D.title": "Fluid Handling",
  "quest.6AA6AFD6E4232701.quest_desc": [
    "Poor villagers, taken over by the parasite."
  ],
  "quest.6AA6AFD6E4232701.title": "Infected Villagers",
  "quest.6B9EDEA363A8EB0B.quest_desc": [
    "A lunar metal used for better rockets, suits and machines."
  ],
  "quest.6B9EDEA363A8EB0B.title": "Desh",
  "quest.6CE7B645F9F1AFAE.quest_desc": [
    "Pumps water into your machines."
  ],
  "quest.6CE7B645F9F1AFAE.title": "Water Pump",
  "quest.71D178EB7AE7C058.quest_desc": [
    "Build a lunar base out of desh."
  ],
  "quest.71D178EB7AE7C058.title": "Desh Building",
  "quest.72A8EAC2E72D7B47.quest_desc": [
    "The Martian crust contains iron, copper, gold, osmium and uranium. Rare Unobtainium veins may be found between Y=-48 and Y=16; native Allthemodium mining rules apply. Raw materials follow the existing GSPack unification rules. Mine with suitable tools and keep your oxygen supply in view."
  ],
  "quest.72A8EAC2E72D7B47.title": "Martian Resources",
  "quest.76855D39EF5F4C94.quest_desc": [
    "Tough tools made from titanium."
  ],
  "quest.76855D39EF5F4C94.title": "Titanium Tools",
  "quest.7AEE9C2F4946B9B8.quest_desc": [
    "Something lives in the lunar forests, and it can infect people..."
  ],
  "quest.7AEE9C2F4946B9B8.title": "Parasites",
  "quest.7D79939AB3CF76AA.quest_desc": [
    "Find a meteor crater. Meteorites hold rare materials."
  ],
  "quest.7D79939AB3CF76AA.title": "Meteor",
  "quest.7F5660F27EF25E94.quest_desc": [
    "Shadows that hunt in the dark."
  ],
  "quest.7F5660F27EF25E94.title": "Luna Shadow",
