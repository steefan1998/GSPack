{
  "chapter.69E2A5F4FD529B95.chapter_subtitle": [
    "Dark magic: blood, spirits, werewolves and brooms."
  ],
  "chapter.69E2A5F4FD529B95.title": "EvilCraft",
  "quest.07D7D774AA3A3F67.quest_desc": [
    "Stores blood. Combine tanks in the crafting grid to make a bigger one."
  ],
  "quest.07D7D774AA3A3F67.title": "Dark Tank",
  "quest.0C3AAEC37FE182C2.quest_desc": [
    "Keep a &eBlood Extractor&r in your inventory while you slay mobs and it collects their blood.",
    "",
    "Shift + right-click to empty it, or turn on auto-supply."
  ],
  "quest.0C3AAEC37FE182C2.title": "Blood Extractor",
  "quest.0CCF566503355370.quest_desc": [
    "Look into the spirit world and see the Vengeance Spirits around you."
  ],
  "quest.0CCF566503355370.title": "Spectral Glasses",
  "quest.0FC4E2ED44CF001C.quest_desc": [
    "Dried blood. Break Hardened Blood with Flint and Steel to get shards."
  ],
  "quest.0FC4E2ED44CF001C.title": "Hardened Blood",
  "quest.23AA664A8D9B98AE.quest_desc": [
    "The guide book of EvilCraft. You cannot craft it:",
    "",
    "Feed a &eDarkened Apple&r to an animal, then quickly throw a &eBook&r at the anomaly that appears.",
    "",
    "Read it to learn everything about EvilCraft."
  ],
  "quest.23AA664A8D9B98AE.title": "Origins of Darkness",
  "quest.2673AE7DFE6A35BA.quest_desc": [
    "A powerful magic mace. The Origins of Darkness explains what it does."
  ],
  "quest.2673AE7DFE6A35BA.title": "Mace of Distortion",
  "quest.2A19A0D22C67C534.quest_desc": [
    "Repairs the items inside it, using blood."
  ],
  "quest.2A19A0D22C67C534.title": "Blood Chest",
  "quest.302821A7C06F1126.quest_desc": [
    "An Undead Sapling grows into an Undead Tree."
  ],
  "quest.302821A7C06F1126.title": "Undead Tree",
  "quest.3B0A84F701F3F733.quest_desc": [
    "Werewolves are dangerous. Defeat one and take its fur."
  ],
  "quest.3B0A84F701F3F733.title": "Werewolf",
  "quest.45D2813A922F4D28.quest_desc": [
    "Found at &eDark Temples&r: break one to get its core. It works with the weather and Weather Containers: see the Origins of Darkness. Later you can craft the Sanguinary version."
  ],
  "quest.45D2813A922F4D28.title": "Environmental Accumulator",
  "quest.474FB2406FDE78C7.quest_desc": [
    "&bEvilCraft&r is dark magic built on &cblood&r, spirits and forbidden knowledge.",
    "",
    "It starts with &eDark Gems&r. Mine &eDark Ore&r underground."
  ],
  "quest.474FB2406FDE78C7.quest_subtitle": "Discover the first evil age",
  "quest.474FB2406FDE78C7.title": "Dark Gems",
  "quest.49AAE5255D7B23C7.quest_desc": [
    "The main EvilCraft machine: it infuses items with blood to make new materials. Check JEI for its recipes."
  ],
  "quest.49AAE5255D7B23C7.title": "Blood Infuser",
  "quest.565DBCE068587453.quest_desc": [
    "Traps a Vengeance Spirit inside."
  ],
  "quest.565DBCE068587453.title": "Box of Eternal Closure",
  "quest.6165C0911728C01E.quest_desc": [
    "Vengeance Spirits roam the world, mostly unseen. Defeat a few."
  ],
  "quest.6165C0911728C01E.title": "Vengeance Spirits",
  "quest.644373722FB27198.quest_desc": [
    "A disenchanter. A Blook placed in it absorbs the enchantments of an item."
  ],
  "quest.644373722FB27198.title": "Purifier",
  "quest.6750758B4455A305.quest_desc": [
    "I can fly! Broom parts give your broom different modifiers: check their tooltips."
  ],
  "quest.6750758B4455A305.title": "Broom",
  "quest.70C05CE545CC1D69.quest_desc": [
    "Cooks Vengeance Spirits to get their drops. A mob farm without the mobs!"
  ],
  "quest.70C05CE545CC1D69.title": "Spirit Furnace",
  "quest.773C631575C36B48.quest_desc": [
    "An apple corrupted with dark power. You need it to get the guide book."
  ],
  "quest.773C631575C36B48.title": "Darkened Apple"
}
